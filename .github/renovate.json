{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ryo246912/renovate-config"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 0,
  "minimumReleaseAge": "3 days",
  "mise": {
    "managerFilePatterns": ["mise*.toml", "config/mise/**/*.toml", "config-mac/mise/**/*.toml"]
  },
  "devcontainer": {
    "managerFilePatterns": ["config/devcontainer/**/devcontainer.json"]
  },
  "constraints": {
    "apm": "0.33.0"
  },
  "apm": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "customDatasources": {
    "brew-formula": {
      "defaultRegistryUrlTemplate": "https://formulae.brew.sh/api/formula/{{{packageName}}}.json",
      "transformTemplates": [
        "{ \"releases\": [ { \"version\": versions.stable, \"isDeprecated\": deprecated, \"digest\": urls.stable.checksum } ], \"homepage\": homepage, \"sourceUrl\": (urls.head.url ? urls.head.url : homepage), \"changelogUrl\": ($contains($string(urls.head.url ? urls.head.url : homepage), 'github.com') ? $join([$replace((urls.head.url ? urls.head.url : homepage), /\\.git$/, ''), '/releases'], '') : '') }"
      ],
      "format": "json"
    },
    "brew-cask": {
      "defaultRegistryUrlTemplate": "https://formulae.brew.sh/api/cask/{{{packageName}}}.json",
      "transformTemplates": [
        "{ \"releases\": [ { \"version\": version, \"isDeprecated\": deprecated, \"digest\": sha256 } ], \"homepage\": homepage, \"sourceUrl\": homepage, \"changelogUrl\": ($contains($string(homepage), 'github.com') ? $join([$replace((homepage), /\\.git$/, ''), '/releases'], '') : '') }"
      ],
      "format": "json"
    },
    "opencode-deepseek-flash-free": {
      "description": "models.dev の OpenCode Zen 無料モデル deepseek-v<version>-flash-free の version を返す",
      "defaultRegistryUrlTemplate": "https://models.dev/api.json",
      "transformTemplates": [
        "{ \"releases\": [ $each(opencode.models, function($v, $k) { $contains($k, /^deepseek-v[0-9.]+-flash-free$/) ? { \"version\": $replace($k, /^deepseek-v([0-9.]+)-flash-free$/, \"$1\"), \"releaseTimestamp\": $v.release_date } }) ], \"homepage\": \"https://opencode.ai/docs/zen\" }"
      ],
      "format": "json"
    }
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "/(^|\\/)flyctl$/",
        "/(^|\\/)stripe-cli$/",
        "/(^|\\/)usage$/",
        "render-oss/cli",
        "renovate",
        "/(^|\\/)aws-cli$/",
        "/(^|\\/)cosign$/",
        "/(^|\\/)rust$/",
        "/(^|\\/)pdm$/",
        "/(^|\\/)cspell$/"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "matchPackageNames": ["docker/cli", "aqua:docker/cli"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "mise lock が生成する .mise/locks 配下は mise の更新 PR で一緒に更新されるため npm manager では更新しない",
      "matchManagers": ["npm"],
      "matchFileNames": [".mise/locks/**"],
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go modules"
    },
    {
      "matchDepNames": ["github:jonas/tig"],
      "versionCompatibility": "^(?<compatibility>tig-)(?<version>.*)$"
    },
    {
      "matchDepNames": ["github:bitwarden/clients"],
      "versionCompatibility": "^(?<compatibility>cli-v)(?<version>.*)$"
    },
    {
      "matchPackageNames": ["ghcr.io/atuinsh/atuin"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchPackageNames": [
        "atuin",
        "atuinsh/atuin",
        "aqua:atuinsh/atuin",
        "ghcr.io/atuinsh/atuin"
      ],
      "groupName": "atuin"
    },
    {
      "matchDepNames": ["aqua:openai/codex", "codex"],
      "extractVersion": "^(?:rust-)?v?(?<version>.+)"
    },
    {
      "matchPackageNames": ["github:ctxrs/ctx", "ctxrs/ctx"],
      "groupName": "ctx"
    },
    {
      "matchPackageNames": [
        "github:tomasz-tomczyk/crit",
        "tomasz-tomczyk/crit",
        "https://github.com/tomasz-tomczyk/crit"
      ],
      "groupName": "crit"
    },
    {
      "matchPackageNames": [
        "github:backnotprop/plannotator",
        "backnotprop/plannotator",
        "https://github.com/backnotprop/plannotator"
      ],
      "groupName": "plannotator"
    },
    {
      "matchPackageNames": [
        "http:terminal-browser",
        "zenbu-labs/terminal-browser",
        "https://github.com/zenbu-labs/terminal-browser"
      ],
      "groupName": "terminal-browser"
    },
    {
      "description": "mise の APM CLI、Renovate が apm install に使う constraints.apm、apm.lock.yaml の apm_version を同じPRで揃えて更新する（apm:validate-lock-version が一致を要求するため）",
      "matchPackageNames": ["microsoft/apm"],
      "groupName": "apm"
    },
    {
      "matchPackageNames": ["mattpocock/skills"],
      "groupName": "mattpocock/skills"
    },
    {
      "description": "resolving-merge-conflicts は v1.3.0 で upstream から削除されたため v1.2.3 に固定する（apm/apm.yml 参照）",
      "matchManagers": ["apm"],
      "matchDepNames": ["mattpocock/skills/skills/engineering/resolving-merge-conflicts"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pullfrog の無料モデル opencode/deepseek-v<version>-flash-free を新しい version に上げる",
      "managerFilePatterns": [".github/workflows/pullfrog.yml"],
      "matchStrings": ["model:\\s*opencode/deepseek-v(?<currentValue>[0-9.]+)-flash-free"],
      "depNameTemplate": "opencode/deepseek-flash-free",
      "datasourceTemplate": "custom.opencode-deepseek-flash-free",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "constraints.apm は組み込みの renovate-config manager が microsoft/apm として抽出するため、ここでは lockfile の apm_version だけを扱う",
      "managerFilePatterns": ["apm/apm.lock.yaml"],
      "matchStrings": ["(?:^|\\n)apm_version:\\s*'?(?<currentValue>[^'\\s]+)'?"],
      "depNameTemplate": "microsoft/apm",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/sbx/mcp.yml"],
      "matchStrings": [
        "command:\\s*npx\\s*\\n\\s*args:\\s*\\[[^\\]]*?\"(?<depName>(?:@[^/\"\\s]+/)?[^@\"\\s]+)@(?<currentValue>[^\"\\s]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/sbx/mcp.yml"],
      "matchStrings": [
        "command:\\s*uvx\\s*\\n\\s*args:\\s*\\[[^\\]]*?\"(?<depName>[^@\"\\s]+)@(?<currentValue>[^\"\\s]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/devcontainer/Dockerfile*"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nARG\\s+\\w+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/atuin/fly.toml"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>ghcr\\.io/atuinsh/atuin):(?<currentValue>v?[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/agentsview/fly.toml"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>ghcr\\.io/kenn-io/agentsview):(?<currentValue>v?[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml"],
      "matchStrings": ["npm:@devcontainers/cli\\s*=\\s*\"(?<currentValue>.*?)\""],
      "depNameTemplate": "devcontainers/cli",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["mise*.toml", "config/mise/**/*.toml"],
      "matchStrings": ["min_version\\s*=\\s*\"(?<currentValue>.*?)\""],
      "depNameTemplate": "jdx/mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml"],
      "matchStrings": [
        "\"go:github\\.com/atotto/clipboard/cmd/(?:gocopy|gopaste)\"\\s*=\\s*\"(?<currentValue>.*?)\""
      ],
      "packageNameTemplate": "github.com/atotto/clipboard",
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml"],
      "matchStrings": ["pipx:awslogs\\s*=\\s*\"(?<currentValue>.*?)\""],
      "depNameTemplate": "awslogs",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config-mac/mise/config.mac.toml"],
      "matchStrings": [
        "\"http:terminal-browser\"\\s*=\\s*\\{\\s*version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "http:terminal-browser",
      "packageNameTemplate": "zenbu-labs/terminal-browser",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml"],
      "matchStrings": [
        "\"http:[^\"]+\"\\s*=\\s*\\{[^}]*?version = \"(?<currentValue>[^\"]+)\"[^}]*?url = \"https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/refs/tags/"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml"],
      "matchStrings": [
        "\"http:[^\"]+\"\\s*=\\s*\\{[^}]*?version = \"(?<currentDigest>[0-9a-f]{40})\"[^}]*?url = \"https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/[^\n#]+[ \t]*#[ \t]*renovate: branch=(?<currentValue>main|master)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml", "config-mac/mise/**/*.toml"],
      "matchStrings": [
        "\"brew:(?<depName>[^\"]+)\"[ \\t]*=[ \\t]*\"latest\"[ \\t]*#[ \\t]*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "custom.brew-formula"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["config/mise/**/*.toml", "config-mac/mise/**/*.toml"],
      "matchStrings": [
        "\"brew-cask:(?<depName>[^\"]+)\"[ \\t]*=[ \\t]*\"latest\"[ \\t]*#[ \\t]*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "custom.brew-cask",
      "versioningTemplate": "loose"
    }
  ]
}
