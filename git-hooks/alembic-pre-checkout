#!/usr/bin/env bash
set -uo pipefail

[[ "${ALEMBIC_GUARD:-}" != 0 ]] || exit 0
git_cmd=${DOTFILES_GIT_EXECUTABLE:-git}

resolve_target() {
  local subcommand=$1 target= creating=0 guess=1
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -b|-B|-c|-C|--orphan)
        [[ $# -ge 2 && "$creating" == 0 ]] || return 1
        creating=1
        shift ;;
      --orphan=*|-b?*|-B?*|-c?*|-C?*)
        [[ "$creating" == 0 ]] || return 1
        creating=1 ;;
      --no-guess|--no-track) guess=0 ;;
      --guess) guess=1 ;;
      --detach|-d|-f|--force|-m|--merge|-q|--quiet|--progress|--no-progress|--track|-t|--track=direct|--track=inherit|--discard-changes|--ignore-other-worktrees|--recurse-submodules|--no-recurse-submodules) ;;
      --) return 1 ;;
      -) [[ -z "$target" ]] || return 1; target='@{-1}' ;;
      -*) return 1 ;;
      *) [[ -z "$target" ]] || return 1; target=$1 ;;
    esac
    shift
  done

  [[ -n "$target" ]] || return 1
  "$git_cmd" rev-parse -q --verify --end-of-options "${target}^{commit}" 2>/dev/null && return 0

  # A guessed tracking branch must be a remote-tracking ref.
  [[ "$guess" == 1 && "$creating" == 0 && "$target" != '@{-1}' ]] || return 1
  if [[ "$subcommand" == checkout && -e "$target" ]]; then
    return 1
  fi
  "$git_cmd" rev-parse -q --verify --end-of-options "refs/remotes/origin/${target}^{commit}" 2>/dev/null
}

case "${1:-}" in
  checkout|switch)
    mode=pre
    new=$(resolve_target "$@") || exit 0
    prev=$("$git_cmd" rev-parse --verify HEAD 2>/dev/null) || exit 0 ;;
  *)
    [[ $# == 3 && "$3" == 1 ]] || exit 0
    mode=post
    prev=$1
    new=$2 ;;
esac

[[ "$prev" != "$new" ]] || exit 0
git_dir=$("$git_cmd" rev-parse --git-dir 2>/dev/null) || exit 0
if [[ -d "$git_dir/rebase-merge" || -d "$git_dir/rebase-apply" || -f "$git_dir/BISECT_LOG" ]]; then
  exit 0
fi

guard_config() {
  "$git_cmd" config --get "dotfiles.alembicGuard.$1"
}

app_dir=$(guard_config appDir) || exit 0
versions_dir=$(guard_config versionsDir) || exit 0
[[ -n "$app_dir" && -n "$versions_dir" ]] || exit 0
root=$("$git_cmd" rev-parse --show-toplevel) || exit 0
cd -- "$root" || exit 0

"$git_cmd" --literal-pathspecs diff --quiet "$prev" "$new" -- "$versions_dir" 2>/dev/null
[[ $? == 1 ]] || exit 0

# Read revision declarations, including type annotations and merge parents.
list_graph() {
  "$git_cmd" --literal-pathspecs grep -E '^(revision|down_revision)[[:space:]:=]' "$1" -- "$versions_dir" 2>/dev/null | awk '
    {
      i = index($0, ".py:"); if (!i) next
      file = substr($0, 1, i + 2); body = substr($0, i + 4)
      eq = index(body, "="); if (!eq) next
      key = substr(body, 1, eq - 1); sub(/[:[:space:]].*/, "", key)
      rest = substr(body, eq + 1); sub(/#.*/, "", rest)
      ids = ""
      while (match(rest, /["\047][0-9A-Za-z_]+["\047]/)) {
        ids = ids (ids == "" ? "" : " ") substr(rest, RSTART + 1, RLENGTH - 2)
        rest = substr(rest, RSTART + RLENGTH)
      }
      if (key == "revision" && ids != "") rev[file] = ids
      if (key == "down_revision") down[file] = ids
    }
    END { for (f in rev) printf "%s\t%s\n", rev[f], down[f] }'
}

prev_graph=$(list_graph "$prev")
new_graph=$(list_graph "$new")
prev_revs=$(printf '%s\n' "$prev_graph" | cut -f1 | LC_ALL=C sort -u)
new_revs=$(printf '%s\n' "$new_graph" | cut -f1 | LC_ALL=C sort -u)
[[ "$prev_revs" != "$new_revs" ]] || exit 0

db_service=$(guard_config dbService)
app_service=$(guard_config appService)
db_user=$(guard_config dbUser)
db_name=$(guard_config dbName)

if ! db_revs=$(cd -- "$app_dir" && docker compose exec -T "${db_service:-db}" \
  psql -U "${db_user:-postgres}" -d "${db_name:-postgres}" -tAc \
  'select version_num from alembic_version' 2>/dev/null); then
  db_revs=
fi

if [[ -z "$db_revs" ]]; then
  only_prev=$(LC_ALL=C comm -23 <(printf '%s\n' "$prev_revs") <(printf '%s\n' "$new_revs"))
  if [[ -n "$only_prev" ]]; then
    printf '[alembic-guard] DB の revision を確認できません。切替元にだけ存在する revision:\n%s\n' "$only_prev" >&2
  fi
  exit 0
fi

in_new() { grep -Fxq -- "$1" <<< "$new_revs"; }

common_ancestor() {
  awk -F '\t' -v start="$1" -v revisions="$new_revs" '
    { parents[$1] = $2 }
    END {
      n = split(revisions, ids, "\n")
      for (i = 1; i <= n; i++) present[ids[i]] = 1
      queue[1] = start; tail = 1; seen[start] = 1
      for (head = 1; head <= tail; head++) {
        id = queue[head]
        if (present[id]) { print id; exit }
        n = split(parents[id], ids, " ")
        for (i = 1; i <= n; i++)
          if (!(ids[i] in seen)) { seen[ids[i]] = 1; queue[++tail] = ids[i] }
      }
    }' <<< "$prev_graph"
}

missing=()
ancestors=()
while IFS= read -r rev; do
  [[ -n "$rev" ]] || continue
  in_new "$rev" && continue
  missing+=("$rev")
  ancestors+=("$(common_ancestor "$rev")")
done <<< "$db_revs"
[[ ${#missing[@]} -gt 0 ]] || exit 0

downgrade_to=${ancestors[0]}
for ancestor in "${ancestors[@]}"; do
  if [[ "$ancestor" != "$downgrade_to" ]]; then
    downgrade_to=
    break
  fi
done

{
  printf '[alembic-guard] 切替先に存在しない DB revision を検出しました。\n'
  for i in "${!missing[@]}"; do
    printf '  %s → 共通祖先 %s\n' "${missing[i]}" "${ancestors[i]:-（特定できず。alembic history で確認）}"
  done
  if [[ "$mode" == pre ]]; then
    printf '切替を中止しました。今のブランチで downgrade してから切り替えてください。\n'
  else
    prev_ref=$("$git_cmd" rev-parse --abbrev-ref '@{-1}' 2>/dev/null)
    if [[ -z "$prev_ref" || $("$git_cmd" rev-parse --verify "$prev_ref" 2>/dev/null) != "$prev" ]]; then
      prev_ref=$prev
    fi
    new_ref=$("$git_cmd" symbolic-ref --quiet --short HEAD 2>/dev/null) || new_ref=$new
    printf '切替元へ戻り、downgrade してから %q に切り替え直してください。\n' "$new_ref"
    printf '  ALEMBIC_GUARD=0 git checkout %q\n' "$prev_ref"
  fi
  if [[ -n "$downgrade_to" ]]; then
    printf '  (cd %q && docker compose run --rm %q alembic downgrade %q)\n' "$root/$app_dir" "${app_service:-app}" "$downgrade_to"
  else
    printf '  (cd %q && docker compose run --rm %q alembic downgrade <revision>)\n' "$root/$app_dir" "${app_service:-app}"
  fi
  if [[ "$mode" == pre ]]; then
    printf 'DB を維持したまま切り替える場合は、先頭に ALEMBIC_GUARD=0 を付けてください。\n'
  fi
} >&2
exit 1
