# work3 でだけ sandbox から使う MCP サーバ。
# `cp mcp.work3.yml.example mcp.work3.yml` で .example を外してコピーし、xxx を実際の値に置き換える。
# mcp.<name>.yml は gitignore 済みで、mise run sandbox:mcp と sbx-agent が mcp.yml と一緒に読む。
# 書式は mcp.yml と同じ（APM の dependencies.mcp + sbx_options）。Renovate の更新対象外。
dependencies:
  mcp:
    # OAuth。初回のみブラウザで認可する
    - name: notion
      registry: false
      transport: http
      url: https://mcp.notion.com/mcp
    # AWS の remote MCP をホストの AWS プロファイルで proxy する。
    # --project は相対パスなので、sbx_options の --dir に work3 のリポジトリ（tools/aws-mcp-proxy がある所）を指定する
    - name: aws-mcp
      registry: false
      transport: stdio
      command: uv
      args:
        - run
        - --project
        - tools/aws-mcp-proxy
        - --frozen
        - mcp-proxy-for-aws
        - https://aws-mcp.us-east-1.api.aws/mcp
        - --profile
        - xxx
        - --metadata
        - AWS_REGION=ap-northeast-1
      sbx_options: ["--dir", "/Users/xxx/work3/xxx"]
    # URL の `,` は --url にそのまま渡る（--args の `,` 区切りの制約は stdio の args だけ）
    - name: datadog
      registry: false
      transport: http
      url: https://mcp.ap1.datadoghq.com/v1/mcp?toolsets=core,apm,dbm,error-tracking,ddsql&omit_tools=create_datadog_notebook,edit_datadog_notebook,upsert_datadog_dashboard,update_datadog_error_tracking_issue,manage_datadog_error_tracking_issue_comments,ddsql_upsert_saved_query
    - name: metabase
      registry: false
      transport: http
      url: https://metabase.xxx.com/api/mcp
    # ホストで起動している Figma デスクトップアプリの MCP。gateway はホストから接続するので
    # 127.0.0.1 はホストを指す。ループバック宛ては sbx の SSRF チェックで拒否されるため外す
    - name: figma-desktop
      registry: false
      transport: http
      url: http://127.0.0.1:3845/mcp
      sbx_options: ["--skip-ssrf-check"]
