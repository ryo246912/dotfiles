# work2 でだけ使う MCP サーバ。
# `cp mcp.work2.yml.example mcp.work2.yml` で .example を外してコピーして使う。
# mcp.<name>.yml は gitignore 済みで、mise run apm:install（mcpc）と sandbox:add-mcp が mcp.yml と一緒に読む。
# 置いた後は mise bootstrap dotfiles apply で ~/.config/mcpc へ配置してから mise run apm:install する。
# 書式は mcp.yml と同じ（APM の dependencies.mcp + sbx_options）。Renovate の更新対象外。
dependencies:
  mcp:
    # 2 つ目・3 つ目の Chrome（--remote-debugging-port=9223 / 9224）に接続する
    - name: chrome-devtools-2
      registry: false
      transport: stdio
      command: npx
      args: ["-y", "chrome-devtools-mcp@1.10.1", "--browser-url=http://localhost:9223"]
    - name: chrome-devtools-3
      registry: false
      transport: stdio
      command: npx
      args: ["-y", "chrome-devtools-mcp@1.10.1", "--browser-url=http://localhost:9224"]
