{
  "version": 1,
  "hooks": {},
  "claudecode": {
    "hooks": {
      "sessionStart": [
        {
          "matcher": "clear",
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
          "timeout": 30
        }
      ],
      "sessionEnd": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
          "timeout": 30
        },
        {
          "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
          "timeout": 1
        }
      ],
      "preCompact": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
          "timeout": 30
        }
      ],
      "preToolUse": [
        {
          "matcher": "Bash",
          "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi",
          "timeout": 5
        },
        {
          "matcher": "^(Bash|mcp__.*)$",
          "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
          "timeout": 10
        }
      ],
      "postToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '.tool_input.file_path + \"\\u0000\"' | xargs -0 -r -- perl -lpi -e 's/[ \\t]+$//' --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '(.tool_input.file_path | select(endswith(\".ts\") or endswith(\".tsx\"))) + \"\\u0000\"' | xargs -0 -r -- tsgo --noEmit --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '(.tool_input.file_path | select(endswith(\".toml\"))) + \"\\u0000\"' | xargs -0 -r -- taplo format --check --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '(.tool_input.file_path | select(endswith(\".sh\"))) + \"\\u0000\"' | xargs -0 -r -- shfmt --write --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "f=\"$HOME/.local/bin/yomiyasu-md-hook\"; [ -x \"$f\" ] || exit 0; exec \"$f\"",
          "timeout": 30
        }
      ],
      "userPromptExpansion": [
        {
          "matcher": "^(yomiyasu|yomiyasu:yomiyasu)$",
          "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
          "timeout": 5
        }
      ],
      "beforeSubmitPrompt": [
        {
          "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
          "timeout": 5
        }
      ],
      "stop": [
        {
          "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
          "timeout": 30
        }
      ]
    }
  },
  "copilot": {
    "hooks": {
      "sessionStart": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool copilot",
          "timeout": 30
        }
      ],
      "sessionEnd": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool copilot",
          "timeout": 30
        }
      ]
    }
  },
  "codexcli": {
    "hooks": {
      "beforeSubmitPrompt": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool codex",
          "timeout": 30,
          "statusMessage": "Checking rule update suggestions"
        },
        {
          "command": "s=\"$HOME/.agents/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host codex",
          "timeout": 5
        }
      ],
      "stop": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool codex",
          "timeout": 30,
          "statusMessage": "Reviewing recent transcript for rule updates"
        },
        {
          "command": "if command -v plannotator >/dev/null 2>&1; then plannotator; fi",
          "timeout": 345600,
          "statusMessage": "Opening plan in Plannotator"
        },
        {
          "command": "s=\"$HOME/.agents/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host codex",
          "timeout": 30
        }
      ],
      "preToolUse": [
        {
          "matcher": "^Bash$|^mcp__.*",
          "command": "s=\"$HOME/.agents/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host codex",
          "timeout": 10
        }
      ],
      "postToolUse": [
        {
          "matcher": "^Bash$",
          "command": "s=\"$HOME/.agents/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host codex",
          "timeout": 10
        }
      ],
      "sessionEnd": [
        {
          "command": "s=\"$HOME/.agents/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host codex",
          "timeout": 2
        }
      ]
    }
  }
}
