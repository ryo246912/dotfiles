{
  "version": 1,
  "hooks": {},
  "claudecode": {
    "hooks": {
      "sessionStart": [
        {
          "matcher": "clear",
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
          "timeout": 30
        },
        {
          "command": "if command -v agent-lessons-context >/dev/null 2>&1; then agent-lessons-context; fi",
          "timeout": 40
        }
      ],
      "sessionEnd": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
          "timeout": 30
        }
      ],
      "preCompact": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
          "timeout": 30
        }
      ],
      "preToolUse": [
        {
          "matcher": "EnterPlanMode",
          "command": "if command -v plannotator >/dev/null 2>&1; then plannotator improve-context; fi",
          "timeout": 5
        },
        {
          "matcher": "Bash",
          "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi",
          "timeout": 5
        },
        {
          "matcher": "Bash",
          "command": "f=\"$HOME/.config/devcontainer/scripts/coderabbit-review.sh\"; [ -x \"$f\" ] || exit 0; \"$f\"",
          "timeout": 600
        }
      ],
      "permissionRequest": [
        {
          "matcher": "ExitPlanMode",
          "command": "if command -v plannotator >/dev/null 2>&1; then plannotator; fi",
          "timeout": 345600
        }
      ],
      "postToolUse": [
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '.tool_input.file_path + \"\\u0000\"' | xargs -0 -r -- perl -lpi -e 's/[ \\t]+$//' --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '(.tool_input.file_path | select(endswith(\".ts\") or endswith(\".tsx\"))) + \"\\u0000\"' | xargs -0 -r -- tsgo --noEmit --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '(.tool_input.file_path | select(endswith(\".toml\"))) + \"\\u0000\"' | xargs -0 -r -- taplo format --check --"
        },
        {
          "matcher": "Write|Edit|MultiEdit",
          "command": "jq -j '(.tool_input.file_path | select(endswith(\".sh\"))) + \"\\u0000\"' | xargs -0 -r -- shfmt --write --"
        }
      ]
    }
  },
  "copilot": {
    "hooks": {
      "sessionStart": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool copilot",
          "timeout": 30
        }
      ],
      "sessionEnd": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool copilot",
          "timeout": 30
        }
      ]
    }
  },
  "codexcli": {
    "hooks": {
      "sessionStart": [
        {
          "command": "if command -v agent-lessons-context >/dev/null 2>&1; then agent-lessons-context; fi",
          "timeout": 40
        }
      ],
      "beforeSubmitPrompt": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool codex",
          "timeout": 30,
          "statusMessage": "Checking rule update suggestions"
        }
      ],
      "stop": [
        {
          "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool codex",
          "timeout": 30,
          "statusMessage": "Reviewing recent transcript for rule updates"
        },
        {
          "command": "if command -v plannotator >/dev/null 2>&1; then plannotator; fi",
          "timeout": 345600,
          "statusMessage": "Opening plan in Plannotator"
        }
      ],
      "preToolUse": [
        {
          "matcher": "Bash|exec_command|shell_command|shell",
          "command": "f=\"$HOME/.config/devcontainer/scripts/coderabbit-review.sh\"; [ -x \"$f\" ] || exit 0; \"$f\"",
          "timeout": 600
        }
      ]
    }
  },
  "copilotcli": {
    "hooks": {
      "preToolUse": [
        {
          "command": "f=\"$HOME/.config/devcontainer/scripts/coderabbit-review.sh\"; [ -x \"$f\" ] || exit 0; \"$f\"",
          "timeout": 600
        }
      ]
    }
  }
}
