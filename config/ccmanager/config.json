{
  "shortcuts": {
    "returnToMenu": {
      "ctrl": true,
      "key": "e"
    },
    "cancel": {
      "key": "escape"
    }
  },
  "statusHooks": {
    "idle": {
      "command": "if [ -n \"$TMUX\" ]; then macos-notify-cli --title \"CCManager - Idle\" --message \"${CCMANAGER_WORKTREE_PATH}の${CCMANAGER_WORKTREE_BRANCH}がIdle状態です\" --sound Hero --current-tmux; else macos-notify-cli --title \"CCManager - Idle\" --message \"${CCMANAGER_WORKTREE_PATH}の${CCMANAGER_WORKTREE_BRANCH}がIdle状態です\" --sound Hero; fi",
      "enabled": true
    },
    "waiting_input": {
      "command": "if [ -n \"$TMUX\" ]; then macos-notify-cli --title \"CCManager - 入力待ち\" --message \"${CCMANAGER_WORKTREE_PATH}の${CCMANAGER_WORKTREE_BRANCH}が入力待ちです\" --sound Glass --current-tmux; else macos-notify-cli --title \"CCManager - 入力待ち\" --message \"${CCMANAGER_WORKTREE_PATH}の${CCMANAGER_WORKTREE_BRANCH}が入力待ちです\" --sound Glass; fi",
      "enabled": true
    }
  },
  "worktree": {
    "autoDirectory": true,
    "autoDirectoryPattern": "../worktrees/{project}-{branch}",
    "copySessionData": true,
    "sortByLastSession": true,
    "autoUseDefaultBranch": false,
    "includeRemoteBranches": true
  },
  "command": {
    "command": "claude"
  },
  "commandPresets": {
    "presets": [
      {
        "id": "1",
        "name": "Claude account1",
        "command": "claude",
        "args": ["--dangerously-skip-permissions"],
        "fallbackArgs": []
      },
      {
        "id": "8",
        "name": "Claude account2",
        "command": "sh",
        "args": [
          "-c",
          "CLAUDE_CONFIG_DIR=\"$HOME/.claude-account2\" exec claude --dangerously-skip-permissions"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "10",
        "name": "Claude Work3",
        "command": "sh",
        "args": [
          "-c",
          "CLAUDE_CONFIG_DIR=\"$HOME/.claude-work3\" exec claude --dangerously-skip-permissions"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": ["--yolo"],
        "detectionStrategy": "codex",
        "fallbackArgs": ["--yolo"]
      },
      {
        "id": "copilot",
        "name": "Copilot",
        "command": "copilot",
        "detectionStrategy": "github-copilot",
        "args": ["--yolo"],
        "fallbackArgs": ["--yolo"]
      },
      {
        "id": "sbx",
        "name": "Claude account1 (Docker Sandbox)",
        "command": "zsh",
        "args": ["-c", "exec sbx-agent claude --name-prefix a1 -- \"$@\"", "sbx-agent"],
        "fallbackArgs": ["-c", "exec sbx-agent claude --name-prefix a1 -- \"$@\"", "sbx-agent"],
        "detectionStrategy": "claude"
      },
      {
        "id": "sbx-account2",
        "name": "Claude account2 (Docker Sandbox)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent claude --config-dir \"$HOME/.claude-account2\" --name-prefix a2 -- \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent claude --config-dir \"$HOME/.claude-account2\" --name-prefix a2 -- \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "sbx-work3",
        "name": "Claude Work3 (Docker Sandbox)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent claude --config-dir \"$HOME/.claude-work3\" --name-prefix w3 -- \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent claude --config-dir \"$HOME/.claude-work3\" --name-prefix w3 -- \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "sbx-codex",
        "name": "Codex (Docker Sandbox)",
        "command": "zsh",
        "args": ["-c", "exec sbx-agent codex -- resume --yolo \"$@\"", "sbx-agent"],
        "fallbackArgs": ["-c", "exec sbx-agent codex -- --yolo \"$@\"", "sbx-agent"],
        "detectionStrategy": "codex"
      },
      {
        "id": "sbx-copilot",
        "name": "Copilot (Docker Sandbox)",
        "command": "zsh",
        "args": ["-c", "exec sbx-agent copilot -- --resume --yolo \"$@\"", "sbx-agent"],
        "fallbackArgs": ["-c", "exec sbx-agent copilot -- --yolo \"$@\"", "sbx-agent"],
        "detectionStrategy": "github-copilot"
      },
      {
        "id": "sbx-env",
        "name": "Claude account1 (Sandbox env + kit)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent claude --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --name-prefix env-a1 -- \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent claude --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --name-prefix env-a1 -- \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "sbx-env-account2",
        "name": "Claude account2 (Sandbox env + kit)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent claude --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --config-dir \"$HOME/.claude-account2\" --name-prefix env-a2 -- \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent claude --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --config-dir \"$HOME/.claude-account2\" --name-prefix env-a2 -- \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "sbx-env-work3",
        "name": "Claude Work3 (Sandbox env + kit)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent claude --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --config-dir \"$HOME/.claude-work3\" --name-prefix env-w3 -- \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent claude --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --config-dir \"$HOME/.claude-work3\" --name-prefix env-w3 -- \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "claude"
      },
      {
        "id": "sbx-env-codex",
        "name": "Codex (Sandbox env + kit)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent codex --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --name-prefix env -- resume --yolo \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent codex --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --name-prefix env -- --yolo \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "codex"
      },
      {
        "id": "sbx-env-copilot",
        "name": "Copilot (Sandbox env + kit)",
        "command": "zsh",
        "args": [
          "-c",
          "exec sbx-agent copilot --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --name-prefix env -- --resume --yolo \"$@\"",
          "sbx-agent"
        ],
        "fallbackArgs": [
          "-c",
          "exec sbx-agent copilot --env-file \"$HOME/.config/sbx/sbxenv.yaml\" --name-prefix env -- --yolo \"$@\"",
          "sbx-agent"
        ],
        "detectionStrategy": "github-copilot"
      }
    ],
    "defaultPresetId": "1",
    "selectPresetOnStart": true
  },
  "worktreeHooks": {
    "post_creation": {
      "command": "",
      "enabled": false
    }
  },
  "autoApproval": {
    "enabled": false,
    "timeout": 120
  }
}
