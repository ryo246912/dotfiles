# syntax=docker/dockerfile:1
#
# Docker Sandboxes 用のカスタム template。
# devcontainer の Dockerfile と同じツール群（このディレクトリの mise.toml）を sandbox の
# Linux microVM 側に入れる。ホストの mise で入れたツールは macOS バイナリなので
# sandbox（Linux）では一切使えないため、こちらで別に入れ直す必要がある。
#
# build context は dotfiles リポジトリ側のこのディレクトリ（config/devcontainer）。
# 配置先（~/.config/devcontainer）を使うと、実体ファイルでない場合に BuildKit が
# コンテキスト外の symlink を辿れず COPY が "not found" で失敗する:
#   mise run sandbox:build-template
#
# devcontainer との対応:
#   - mise.toml / tasks/ / lint/ / scripts/ / lefthook.local.yml は devcontainer と共有する。
#     devcontainer が bind mount していたのと同じ `~/.config/devcontainer` 配下へ COPY するので、
#     tasks が参照する `${XDG_CONFIG_HOME:-$HOME/.config}/devcontainer/lint/...` がそのまま解決する。
#   - base image は Docker 提供の sandbox template（Ubuntu + 非 root の agent ユーザー + sudo）。
#     `claude-code-docker` を使う。sandbox 内に dockerd を持つのは `-docker` 版だけで、通常版
#     には docker CLI しか無い。-docker 版から作った sandbox はエージェントのコンテナが microVM 内で
#     特権モードになり、/var/lib/docker に専用ボリュームが付いて dockerd が自動起動する。
#     agent を含まない `shell-docker` は使えない。template には版（FLAVOR）が記録され、
#     `sbx create claude` は claude 用の kit を当てようとして "failed to apply kit to sandbox"
#     で作成に失敗するため（実機で確認）。
ARG VARIANT=claude-code-docker
FROM docker/sandbox-templates:${VARIANT}

ARG AGENT_HOME=/home/agent

USER root

# curl / ca-certificates / git は base image に入っているが、下の mise のインストールや
# git 操作に必須なので、別の版でビルドしても困らないよう明示しておく。
#
# apt のパッケージリストとダウンロード済み .deb は BuildKit の cache mount に置く。
# image の layer には残らないので apt-get clean / rm -rf /var/lib/apt/lists/* は不要で、
# 再ビルド時は差分だけ取得される。sharing=locked は同時ビルドで apt のロックが競合しないため。
# Ubuntu 系 image の /etc/apt/apt.conf.d/docker-clean は install 後に .deb を消すので、
# cache を効かせるために外して Keep-Downloaded-Packages を有効にする。
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    rsync \
    zsh

# 既定シェルを zsh にする（devcontainer と同じ）。
# sbx は /etc/sandbox-persistent.sh を bash 起動時に source する作りなので、
# zsh でも同じ内容を読むよう /etc/zsh/zshenv からも source する。
ENV SHELL=/usr/bin/zsh
RUN chsh -s /usr/bin/zsh agent \
    && install -d /etc/zsh \
    && printf '%s\n' \
      '# sbx が書き込む永続環境変数を zsh でも読む（bash 側は sbx 本体が source する）' \
      '[ -r /etc/sandbox-persistent.sh ] && . /etc/sandbox-persistent.sh' \
      >> /etc/zsh/zshenv

# mise を全ユーザーから使える場所へ入れる
RUN curl https://mise.run | MISE_INSTALL_PATH=/usr/local/bin/mise sh

# data dir と config dir は分ける。同一にすると cache mount からの rsync が
# COPY した config.toml / tasks を上書きしてしまう。
ENV MISE_DATA_DIR=/mise/data \
    MISE_CONFIG_DIR=/mise \
    MISE_STATE_DIR=/mise/state \
    MISE_CACHE_DIR=/mise/cache
# agent セッションは sbx が起動するため、PATH は image 側で確定させる。
# crit ラッパー（scripts/crit）を mise shim より前に置く（docs/crit.md 参照）。
ENV PATH=${AGENT_HOME}/.config/devcontainer/scripts:/mise/data/shims:$PATH

RUN install -d -o agent -g agent /mise /mise/data /mise/cache /mise/state

# mise install より前に COPY するのは mise.toml だけにする。
# 設定ツリー全体をここで COPY すると、scripts/ を 1 行直しただけで下の重い install layer が
# 無効化されてしまうため、残りは install の後に COPY する。
COPY --chown=agent:agent mise.toml /mise/config.toml

# agent CLI（claude / codex / copilot）も mise.toml のバージョンで入れる。base image
# （claude-code-docker）には claude しか入っておらず、同じ template を ccmanager から
# claude / codex / copilot で使い回すため。PATH は mise shim が base image の
# ~/.local/bin より前なので、シェルから呼ぶ agent は mise 側になる。
# 特定のツールを外したい場合は --build-arg DISABLE_TOOLS=<tool>,... で指定する。
ARG DISABLE_TOOLS=""

# root で install して最後に chown する。BuildKit の cache mount の uid を base image の
# agent ユーザーに合わせて決め打ちしないための措置（uid は image 側の都合で変わりうる）。
#
# mise.toml が変わるとこの RUN は必ず再実行されるが、全ツールを毎回ゼロから入れ直すと遅いため、
# インストール済みツール(/mise/data)を cache mount(/mise/data-cache)へ保存し、次回ビルド時に
# 復元してから `mise install` する。差分（バージョンが変わったツール）だけが取得される。
# cache mount は `docker builder prune` で消える（消えても初回と同じフルインストールになるだけ）。
#
# /run/secrets/github_token は build 時に --secret で渡されるホストの GH_TOKEN。
# aqua:/github: backend の API レート制限回避に使う。無くてもビルドは続行する。
#
# mise の trust は実行ユーザーごとに記録されるため、root で `mise trust` しても agent では
# 効かない。ビルド中も実行時も env で宣言する（下の ENV が実行時用）。
RUN --mount=type=secret,id=github_token \
    --mount=type=cache,id=sandbox-mise-cache,target=/mise/cache \
    --mount=type=cache,id=sandbox-mise-data,target=/mise/data-cache,sharing=locked \
    set -eu; \
    export MISE_DISABLE_TOOLS="$DISABLE_TOOLS" \
      MISE_YES=1 \
      MISE_TRUSTED_CONFIG_PATHS=/mise \
      GOMODCACHE=/mise/cache/go-mod \
      GOCACHE=/mise/cache/go-build \
      GOFLAGS=-modcacherw \
      BUN_INSTALL_CACHE_DIR=/mise/cache/bun; \
    if [ -s /run/secrets/github_token ]; then \
      export GITHUB_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    rsync -a /mise/data-cache/ /mise/data/; \
    mise install -C /mise aqua:cli/cli; \
    mise reshim -C /mise; \
    mise install -C /mise; \
    mise prune -C /mise --tools || echo "warn: mise prune failed" >&2; \
    rm -rf /mise/data/downloads; \
    mise reshim -C /mise; \
    rsync -a --delete /mise/data/ /mise/data-cache/; \
    chown -R agent:agent /mise/data /mise/state

# gh stack（github/gh-stack）は gh の公式 extension として入れる。gh 2.102 以降の `stack` は
# 「extension を入れてください」と出すだけの組み込みコマンドで、extension があればそちらが
# 優先される。mise には gh extension の backend が無いので、ここで `gh extension install` する。
# 入り先は agent の ~/.local/share/gh/extensions（~/.config/gh とは別）。token は API の
# レート制限回避用で、GH_CONFIG_DIR を使い捨てにして image には残さない。
# renovate: datasource=github-releases depName=github/gh-stack
ARG GH_STACK_VERSION=v0.2.0
RUN --mount=type=secret,id=github_token \
    set -eu; \
    if [ -s /run/secrets/github_token ]; then \
      export GH_TOKEN="$(cat /run/secrets/github_token)"; \
    fi; \
    install -d -o agent -g agent "${AGENT_HOME}/.local" "${AGENT_HOME}/.local/share"; \
    gh_config="$(mktemp -d)"; \
    MISE_TRUSTED_CONFIG_PATHS=/mise XDG_DATA_HOME="${AGENT_HOME}/.local/share" GH_CONFIG_DIR="$gh_config" \
      /mise/data/shims/gh extension install github/gh-stack --pin "$GH_STACK_VERSION"; \
    rm -rf "$gh_config"; \
    chown -R agent:agent "${AGENT_HOME}/.local/share/gh"

# tasks と設定ツリーは install の後に COPY する（上記の理由でキャッシュを守るため）。
# devcontainer が bind mount していたのと同じ ~/.config/devcontainer 配下へ置くので、
# tasks が参照する ${XDG_CONFIG_HOME:-$HOME/.config}/devcontainer/lint/... がそのまま解決する。
COPY --chown=agent:agent tasks /mise/tasks
COPY --chown=agent:agent . ${AGENT_HOME}/.config/devcontainer

# mise の trust は実行ユーザーごとに記録されるため、root で trust しても agent では効かない。
# 代わりに trusted path を env で宣言する（sbx-agent は workspace を足した値を --env で渡す）。
ENV MISE_TRUSTED_CONFIG_PATHS=/mise

USER agent
WORKDIR ${AGENT_HOME}/workspace
