#!/bin/bash
set -euo pipefail

url=${1:?"Plannotator URL is required"}
editor_port=${PLANNOTATOR_PORT:-19433}
url_pattern="^https?://(localhost|127\\.0\\.0\\.1):${editor_port}([/?#]|$)"
if ! [[ $url =~ $url_pattern ]]; then
	printf 'Unexpected Plannotator URL: %s\n' "$url" >&2
	exit 1
fi

# sandbox ではプロキシ（HTTP(S)_PROXY）が設定されており、NO_PROXY に無いローカル宛ての接続も
# プロキシ経由になって "Approval required…" が返る。/etc/sandbox-persistent.sh 側でも足しているが
# （sandbox-post-create.sh の setup_no_proxy）、それを読まない起動経路や sbx が同ファイルを
# 書き直した場合でも確実に効くよう、ここでも足す（devcontainer ではプロキシが無いので無害）。
for __np_host in 0.0.0.0 localhost 127.0.0.1 ::1; do
	case ",${NO_PROXY:-}," in *",${__np_host},"*) ;; *) NO_PROXY="${NO_PROXY:+${NO_PROXY},}${__np_host}" ;; esac
	case ",${no_proxy:-}," in *",${__np_host},"*) ;; *) no_proxy="${no_proxy:+${no_proxy},}${__np_host}" ;; esac
done
unset __np_host
export NO_PROXY no_proxy

tunnel=${HOME}/.config/devcontainer/scripts/ensure-plannotator-tunnel
"$tunnel" "$editor_port"

# Live annotation uses a second random loopback port for the iframe proxy.
# Read it from the session API and expose the same port number on macOS so the
# iframe URL and frame-ancestors CSP generated by Plannotator stay valid.
origin=$(printf '%s\n' "$url" | sed -E 's#^(https?://[^/?#]+).*#\1#')
plan_json=$(curl -fsS --max-time 5 --retry 2 --retry-delay 1 "${origin}/api/plan" 2>/dev/null || true)
app_url=$(printf '%s' "$plan_json" | python3 -c \
	'import json, sys; print(json.load(sys.stdin).get("appUrl") or "")' 2>/dev/null || true)
if [ -n "$app_url" ]; then
	proxy_port=$(printf '%s\n' "$app_url" | sed -nE 's#^http://(localhost|127\.0\.0\.1):([0-9]+)(/.*)?$#\2#p')
	if [ -z "$proxy_port" ]; then
		printf 'Unexpected Plannotator live-app URL: %s\n' "$app_url" >&2
		exit 1
	fi
	"$tunnel" "$proxy_port"
fi

printf -v url_escaped '%q' "$url"
if timeout 5 ssh -F ~/.config/ssh/config -o BatchMode=yes -o ConnectTimeout=2 \
	mac-host "open ${url_escaped}" 2>/dev/null; then
	printf 'Plannotator reviewをhost browserで開きました: %s\n' "$url"
else
	printf '自動でbrowserを開けませんでした。次のURLを開いてください: %s\n' "$url" >&2
fi
