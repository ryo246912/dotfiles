#!/usr/bin/env bash
# devcontainer / sandbox から SSH 経由でホスト側 tmux の pane を参照する。
# 実際に何を実行できるかはホスト側の gate（host-tmux-gate）と
# ~/.config/host-tmux/commands.sh の定義で決まる。
set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  host-tmux list
  host-tmux capture <pane> [lines]
  host-tmux help                  ホスト側で許可されているコマンドの一覧
  host-tmux <command> [args...]   ホスト側の commands.sh で定義したコマンド

Examples:
  host-tmux list
  host-tmux capture %3 200
EOF
}

case "${1-}" in
'')
	usage >&2
	exit 2
	;;
-h | --help)
	usage
	exit 0
	;;
esac

# リモートへ渡す引数は安全な文字だけに制限する（gate でも同じ検証をする）。
for arg in "$@"; do
	[[ "${arg}" =~ ^[A-Za-z0-9%@._:-]{1,128}$ ]] || {
		echo "host-tmux: argument contains unsupported characters: ${arg}" >&2
		exit 2
	}
done

ssh_config="${HOME}/.config/ssh/config"
[ -f "${ssh_config}" ] || {
	echo "host-tmux: SSH config not found: ${ssh_config}" >&2
	exit 1
}

ssh_opts=(-F "${ssh_config}" -o BatchMode=yes -o ConnectTimeout=5)
if grep -q '^Host mac-host-tmux$' "${ssh_config}"; then
	# tmux 専用鍵。ホストの authorized_keys の command= で gate に固定されているため、
	# 送ったコマンド文字列は SSH_ORIGINAL_COMMAND として gate が解釈する。
	exec timeout 15 ssh "${ssh_opts[@]}" mac-host-tmux "$*"
fi
# 専用鍵が無い環境（devcontainer など）は通常の mac-host 経由で同じ gate を呼ぶ。
exec timeout 15 ssh "${ssh_opts[@]}" mac-host \
	'"${XDG_CONFIG_HOME:-$HOME/.config}"/devcontainer/scripts/host-tmux-gate' "$@"
