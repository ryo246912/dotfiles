#!/usr/bin/env bash
# devcontainer / sandbox からホスト側 tmux の pane を参照する（tmux skill 用）。
# 実体は host-exec の tmux-list / tmux-capture で、ホスト側 gate が許可したものだけ動く。
set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  host-tmux list
  host-tmux capture <pane> [lines]

Examples:
  host-tmux list
  host-tmux capture %3 200
EOF
}

host_exec="$(dirname "$0")/host-exec"

case "${1-}" in
list)
	[ "$#" -eq 1 ] || { usage >&2; exit 2; }
	exec "${host_exec}" tmux-list
	;;
capture)
	[ "$#" -ge 2 ] && [ "$#" -le 3 ] || { usage >&2; exit 2; }
	shift
	exec "${host_exec}" tmux-capture "$@"
	;;
-h | --help)
	usage
	exit 0
	;;
*)
	usage >&2
	exit 2
	;;
esac
