# ~/.config/git/config.secret のサンプル。
# 実ファイルは .gitignore で除外しているためコミット対象外。
# 初回セットアップ時にコピーして値を実際のものに置き換える:
#   cp config/git/config.secret.sample ~/.config/git/config.secret
#
# templates/git/config.tera の [include] から常時読み込まれる（公開したくない上書き設定用）。

[coderabbit]
  machineId = cli/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
