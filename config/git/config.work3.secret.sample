# ~/.config/git/config.work3.secret のサンプル。
# 実ファイルは .gitignore で除外しているためコミット対象外。
# 初回セットアップ時にコピーして値を実際のものに置き換える:
#   cp config/git/config.work3.secret.sample ~/.config/git/config.work3.secret
#
# templates/git/config.tera から以下のタイミングで読み込まれる:
#   - macOS: [includeIf "gitdir:~/Programming/work3/"]
#     （~/Programming/work3/ 配下でのみ、work3 用の上書き設定として）

[user]
  email = xxxxx@work3-domain.example.com
  signingkey = XXXXXXXXXXXXXXXX
