{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "AI_AGENT": "1"
  },
  "cleanupPeriodDays": 36500,
  "autoCompactWindow": 200000,
  "tui": "default",
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Edit(**/*.secret)",
      "Edit(**/.env)",
      "Edit(**/.env*)",
      "Edit(**/.envrc)",
      "Edit(**/fnox.local.toml)",
      "Edit(**/secrets/**)",
      "Edit(*.secret)",
      "Edit(.env*)",
      "Edit(.envrc)",
      "Edit(fnox.local.toml)",
      "Read(**/*.secret)",
      "Read(**/*key*)",
      "Read(**/*token*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/fnox.local.toml)",
      "Read(*.secret)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(fnox.local.toml)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(~/**/*key*)",
      "Read(~/**/*token*)",
      "Read(~/.ssh/id_ed25519)",
      "Read(~/.ssh/id_rsa)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "f=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh\"; [ -x \"$f\" ] || f=\"${CLAUDE_CONFIG_DIR%/*}/.claude/statusline.sh\"; [ -x \"$f\" ] || f=\"$HOME/.claude/statusline.sh\"; \"$f\"",
    "refreshInterval": 30
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "f=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/subagent-statusline.sh\"; [ -x \"$f\" ] || f=\"${CLAUDE_CONFIG_DIR%/*}/.claude/subagent-statusline.sh\"; [ -x \"$f\" ] || f=\"$HOME/.claude/subagent-statusline.sh\"; \"$f\""
  },
  "skillOverrides": {
    "crit": "on",
    "crit-cli": "on",
    "resolving-merge-conflicts": "on",
    "ponytail": "on",
    "ponytail-audit": "on",
    "ponytail-debt": "on",
    "ponytail-gain": "on",
    "ponytail-help": "on",
    "ponytail-review": "on",
    "memo": "on",
    "planning": "on",
    "plannotator-review": "name-only",
    "plannotator-annotate": "name-only",
    "plannotator-last": "name-only",
    "html": "name-only",
    "html-diagram": "name-only",
    "html-plan": "name-only",
    "html-prototype": "name-only",
    "html-wireframe": "name-only",
    "design-artifact": "name-only",
    "terminal-browser": "name-only",
    "grill-me": "name-only",
    "grilling": "name-only",
    "diagram-design": "name-only",
    "pr-reviewer-comment-crit": "name-only",
    "pr-author-fix": "name-only",
    "pr-reviewer-comment": "name-only",
    "pr-reviewer-brief": "name-only",
    "tmux": "name-only",
    "ctx-agent-history-search": "user-invocable-only",
    "find-skills": "user-invocable-only",
    "dev-context": "user-invocable-only",
    "dev-debug": "name-only",
    "dev-impl": "name-only",
    "dev-init": "user-invocable-only",
    "dev-navigate": "user-invocable-only",
    "dev-plan": "user-invocable-only",
    "dev-run": "user-invocable-only",
    "dev-screen-spec": "user-invocable-only",
    "dev-verify": "name-only",
    "dev-webtest": "user-invocable-only",
    "dev-webtest-plan": "user-invocable-only",
    "ipa-security-check": "user-invocable-only",
    "ipa-security-guide": "user-invocable-only",
    "kairo-implement": "user-invocable-only",
    "suggest-rules": "user-invocable-only"
  },
  "git": {
    "includeCoAuthor": false
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading ponytail mode...",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'hooks/ponytail-activate.js'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking i-have-adhd always-on flag...",
            "command": "node -e \"(async()=>{const root=process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT;if(root)await import(require('node:url').pathToFileURL(require('node:path').join(root,'hooks','always-on.mjs')).href)})().catch(()=>{})\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/devcontainer/scripts/ai-rule-hook.sh\" --tool claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v rtk >/dev/null 2>&1; then rtk hook claude; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "plannotator improve-context",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -j '.tool_input.file_path + \"\\u0000\"' | xargs -0 -r -- perl -lpi -e 's/[ \\t]+$//' --"
          },
          {
            "type": "command",
            "command": "jq -j '(.tool_input.file_path | select(endswith(\".ts\") or endswith(\".tsx\"))) + \"\\u0000\"' | xargs -0 -r -- tsgo --noEmit --"
          },
          {
            "type": "command",
            "command": "jq -j '(.tool_input.file_path | select(endswith(\".toml\"))) + \"\\u0000\"' | xargs -0 -r -- taplo format --check --"
          },
          {
            "type": "command",
            "command": "jq -j '(.tool_input.file_path | select(endswith(\".sh\"))) + \"\\u0000\"' | xargs -0 -r -- shfmt --write --"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading ponytail mode...",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'hooks/ponytail-subagent.js'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Tracking ponytail mode...",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'hooks/ponytail-mode-tracker.js'))\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "plannotator",
            "timeout": 345600
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^(yomiyasu|yomiyasu:yomiyasu)$",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/yomiyasu/scripts/yomiyasu_hook.py\"; [ -f \"$s\" ] || exit 0; exec python3 -B \"$s\" --host claude-code",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
