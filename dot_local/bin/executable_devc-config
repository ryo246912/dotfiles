#!/bin/bash
set -eu

# devcontainer CLI の --config に渡す devcontainer.json のパスを出力する。
#
# 1. DEVCONTAINER_CONFIG が設定されていればそれを使う（手動での上書き用）
# 2. カレントディレクトリが multi-worktree の task root なら、生成された
#    .devcontainer/devcontainer.json を使う。task root は linked worktree ではない
#    synthetic repository なので、base template で起動すると配下 repo の common git dir が
#    mount されず、コンテナ内の git が `not a git repository` になる。
# 3. それ以外は base template を使う
#
# repo 自身が持つ .devcontainer/ は AI agent 用ではないため、multi-worktree が生成した
# もの（name が "Multi-worktree: " で始まる）以外は採用しない。

if [[ -n "${DEVCONTAINER_CONFIG:-}" ]]; then
	printf '%s\n' "$DEVCONTAINER_CONFIG"
	exit 0
fi

task_config="${PWD}/.devcontainer/devcontainer.json"
if [[ -f "$task_config" ]] && grep -q '"name":[[:space:]]*"Multi-worktree: ' "$task_config"; then
	printf '%s\n' "$task_config"
	exit 0
fi

printf '%s\n' "${HOME}/.config/devcontainer/devcontainer.json"
