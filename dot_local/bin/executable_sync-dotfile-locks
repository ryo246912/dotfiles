#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: sync-dotfile-locks {mise|apm|all}" >&2
  exit 2
}

kind="${1:-}"
case "$kind" in
  mise | apm | all) ;;
  *) usage ;;
esac

source_dir="${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}"

sync_file() {
  local source_file=$1
  local destination_file=$2

  [ -f "$source_file" ] || return 0
  mkdir -p "${destination_file%/*}"
  if ! cmp -s "$source_file" "$destination_file"; then
    cp "$source_file" "$destination_file"
    echo "Updated chezmoi source lockfile: $destination_file"
  fi
}

if [[ "$kind" == mise || "$kind" == all ]]; then
  # ~/.config/mise は chezmoi が管理する apply 先。devcontainer 等が一時的に設定する
  # MISE_CONFIG_DIR は別の構成なので、dotfiles の lockfile へ混ぜない。
  shopt -s nullglob
  mise_locks=("$HOME/.config/mise"/mise*.lock)
  if ((${#mise_locks[@]} == 0)); then
    echo "mise lockfile not found under $HOME/.config/mise" >&2
    exit 1
  fi
  for source_lock in "${mise_locks[@]}"; do
    sync_file "$source_lock" "$source_dir/dot_config/mise/${source_lock##*/}"
  done
fi

if [[ "$kind" == apm || "$kind" == all ]]; then
  apm_lock="$HOME/.apm/apm.lock.yaml"
  if [[ ! -f "$apm_lock" ]]; then
    echo "APM lockfile not found: $apm_lock" >&2
    exit 1
  fi
  sync_file "$apm_lock" "$source_dir/dot_apm/apm.lock.yaml"
fi
