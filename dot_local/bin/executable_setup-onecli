#!/bin/bash
set -euo pipefail

command_name="${1:-install}"
install_dir="${HOME}/.onecli"
compose_file="${install_dir}/docker-compose.yml"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/onecli"
env_file="${config_dir}/devcontainer.env"
onecli_url="${ONECLI_URL:-http://127.0.0.1:10254}"

case "$command_name" in
	install)
		# 公式 installer が compose 定義の取得、image pull、起動までを行う。
		curl -fsSL https://onecli.sh/install | sh
		printf '\nDashboard で secret と agent を作成後、次を実行してください:\n  setup-onecli configure\n'
		;;
	configure)
		command -v python3 >/dev/null || {
			echo "Error: python3 is required" >&2
			exit 1
		}
		mkdir -p "$config_dir"
		tmp_json="$(mktemp)"
		trap 'rm -f "$tmp_json"' EXIT
		curl -fsS "${onecli_url%/}/v1/container-config" >"$tmp_json"
		python3 - "$tmp_json" "$env_file" "$onecli_url" <<'PY'
import json
import pathlib
import shlex
import sys
import urllib.parse

source, destination, onecli_url = sys.argv[1:]
with open(source, encoding="utf-8") as stream:
    config = json.load(stream)

env = config.get("env")
if not isinstance(env, dict) or not env.get("HTTPS_PROXY"):
    raise SystemExit(f"OneCLI returned an invalid container config: {config}")

proxy = urllib.parse.urlsplit(env["HTTPS_PROXY"])
credentials = proxy.netloc.rsplit("@", 1)[0]
gateway_port = proxy.port or 10255
container_proxy = urllib.parse.urlunsplit(
    (proxy.scheme, f"{credentials}@host.docker.internal:{gateway_port}", "", "", "")
)
container_url = onecli_url.replace("127.0.0.1", "host.docker.internal").replace("localhost", "host.docker.internal")
lines = [
    "# Generated by setup-onecli configure. Do not commit this file.",
    f"ONECLI_URL={shlex.quote(container_url)}",
    f"ONECLI_PROXY_URL={shlex.quote(container_proxy)}",
]
path = pathlib.Path(destination)
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
path.chmod(0o600)
PY
		rm -f "$tmp_json"
		trap - EXIT
		echo "OneCLI devcontainer config was written to $env_file"
		echo "Recreate the devcontainer to apply it."
		;;
	status)
		docker compose -p onecli -f "$compose_file" ps
		;;
	stop)
		docker compose -p onecli -f "$compose_file" down
		;;
	*)
		echo "Usage: setup-onecli {install|configure|status|stop}" >&2
		exit 2
		;;
esac
