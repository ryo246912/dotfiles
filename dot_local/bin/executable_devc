#!/usr/bin/env bash
# カレントディレクトリを workspace として devcontainer up / exec を実行する。
#
#   devc up [devcontainer up のオプション...]
#   devc exec [devcontainer exec のオプション...] [-- <command...>]
#
# ccmanager の --devc-up-command / --devc-exec-command はシェルを通さず、選択した
# project / worktree を cwd にして実行される。--multi-project では project ごとに
# 使う config が異なるため、ここで cwd から判定する（docs/devcontainer.md 参照）。
#
# - multi-worktree の task root: task root に生成された .devcontainer/devcontainer.json
# - それ以外: base template。up では common git dir（実体リポジトリの .git）を
#   ホストと同じ絶対パスに mount し、linked worktree でもコンテナ内で git を使えるようにする

set -euo pipefail

if [[ $# -lt 1 ]] || [[ "$1" != up && "$1" != exec ]]; then
	echo "usage: devc up|exec [options...] [-- <command...>]" >&2
	exit 2
fi
subcommand=$1
shift

workspace=$PWD
base_config="$HOME/.config/devcontainer/devcontainer.json"
task_config="$workspace/.devcontainer/devcontainer.json"

args=(--workspace-folder "$workspace")
# task root は multi-worktree-<task> ブランチの synthetic repository（multi-worktree 参照）
if [[ -f "$task_config" ]] &&
	[[ "$(git -C "$workspace" branch --show-current 2>/dev/null || true)" == multi-worktree-* ]]; then
	args+=(--config "$task_config")
else
	args+=(--config "$base_config")
	if [[ "$subcommand" == up ]] &&
		common_git_dir=$(git -C "$workspace" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
		args+=(--mount "type=bind,source=${common_git_dir},target=${common_git_dir}")
	fi
fi

exec devcontainer "$subcommand" "${args[@]}" "$@"
