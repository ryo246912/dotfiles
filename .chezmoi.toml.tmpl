pager = "delta"
[edit]
args    = ["--wait", "--new-window"]
command = "code"
[scriptEnv]
APPDATA = "/mnt/c/Users/r-ksk/AppData"
USERDIR = "/mnt/c/Users/r-ksk"
[bitwarden]
unlock = "auto"
[hooks.apply.post]
args = [
    "-c",
    """
# post-apply hook は run_once の PATH 変更を引き継がないため、mise 本体と aqua/gh 用の
# mise shims を PATH に通す。mise 本体は mac/linux とも https://mise.run 経由で ~/.local/bin に導入するため、~/.local/bin を先頭にする。mise shims は
# /opt/homebrew/bin より前に置く（後ろだと実 Homebrew 版の gh 等が mise の aqua shim を
# shadow し、後続の `gh auth token` 等が mise 管理外のバイナリを掴んでしまう）。
if [ "$(uname)" = "Darwin" ]; then
  export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:/opt/homebrew/bin:$PATH"
else
  export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
fi
# 1) macOS では新しい config を mise に読ませる前に、mise 本体を
#    min_version へ更新する。run_once_install-mise_mac.sh はこの post-apply hook より
#    先に実行され、mise 未導入時の初回インストールを担う。
#    min_version は mise 自身で config をロードせずテキストとして抽出し、
#    self-update も config を読まずに実行する。
if [ "$(uname)" = "Darwin" ]; then
  mise_config="$HOME/.config/mise/config.toml"
  required_mise_version=$(awk -F'"' '/^[[:space:]]*min_version[[:space:]]*=/ { print $2; exit }' "$mise_config")
  if [ -z "$required_mise_version" ]; then
    echo "error: $mise_config から min_version を取得できません"
    exit 1
  fi
  echo "Ensuring mise $required_mise_version is installed..."
  MISE_NO_CONFIG=1 mise self-update --yes "$required_mise_version" || exit 1
fi

# install マーカー保存用の XDG state を用意（永続化）。
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"
mkdir -p "$state_dir" || exit 1
source_dir=$CHEZMOI_SOURCE_DIR
mise_hash=$(cat "$HOME/.config/mise/config"*.toml 2>/dev/null | (command -v sha1sum >/dev/null && sha1sum || shasum -a 1))

# 2) bootstrap.packages を convergent に導入する。ハッシュマーカーではなく
#    `mise bootstrap packages status --missing`（未同期なら exit 1）で実際の導入状態を判定するので、
#    パッケージ削除等のドリフトも検知して収束し、手動導入後も回復できる（マーカー不整合が起きない）。
#    bottle/deb は sha256 で入る（gpg 不要）ため gpg_verify=true の mise install より前に gnupg を
#    用意できる。mac(brew) は sudo 不要。WSL(apt) は sudo が要るため、sudo プロンプトに応答できる
#    対話端末(TTY)があるときだけ apply する。非対話 WSL で未同期なら required preflight として中断する。
#    HOST_ENV（dot_zshenv.tmpl が host-env.map から解決する "<os>,<role>"）が対話シェルから
#    引き継がれていればそれを使う。config.private.toml/config.work*.toml の [bootstrap.packages]
#    も収束対象に含めるため（未登録ホスト・非対話コンテキストでは OS 単体にフォールバック）。
if [ -n "${HOST_ENV:-}" ]; then
  bootstrap_env="$HOST_ENV"
elif [ "$(uname)" = "Darwin" ]; then
  bootstrap_env=mac
else
  bootstrap_env=linux
fi
if ! MISE_ENV=$bootstrap_env mise bootstrap packages status --missing >/dev/null 2>&1; then
  if [ "$(uname)" = "Darwin" ] || [ -t 0 ]; then
    if ! MISE_ENV=$bootstrap_env mise bootstrap packages apply --yes; then
      # 失敗＝gnupg/tig 等が未導入。gpg_verify=true の mise install が検証で失敗するため
      # degraded 実行を避けて中断する（WSL は sudo のパスワード入力が要る点に注意）。
      echo "error: 'mise bootstrap packages apply' に失敗しました。パッケージ未導入のため中断します"
      exit 1
    fi
  else
    # 非対話端末（TTY 無し）で sudo プロンプトに応答できず、かつ未同期（未導入分あり）。
    # 未導入のまま進むと tig/colordiff 等が欠けたまま完了するため required preflight として中断する。
    # 手動 bootstrap（sudo 可能な端末）で導入後は status が揃い、次回はここを通過できる。
    echo "error: WSL の apt bootstrap が未適用です。対話端末で 'MISE_ENV=linux mise bootstrap packages apply' を実行してから再度 chezmoi apply してください（tig/colordiff 等）"
    exit 1
  fi
fi
# 3) mise install
if [ "$(cat "$state_dir/mise-config-hash" 2>/dev/null)" != "$mise_hash" ]; then
  mise install --jobs=1 aqua:cli/cli || true
  # 未ログインなら対話ログインを実行する
  if ! gh auth token >/dev/null 2>&1; then
    gh auth login --scopes 'project' || true
  fi
  github_token=$(gh auth token 2>/dev/null || true)
  if [ -z "$github_token" ]; then
    echo "error: gh 未ログインのため中断します。'gh auth login --scopes project' 後に再度 chezmoi apply してください"
    exit 1
  fi
  echo "Running mise install..."
  GITHUB_TOKEN=$github_token mise install --jobs=2 || exit 1
  echo "$mise_hash" > "$state_dir/mise-config-hash"
fi
# 4) APM の user-scope dependencies を各エージェントへ反映する。
#    manifest/lockfile の内容が前回の成功時から変わった場合だけ実行し、毎回の apply で
#    スキルの install・command 同期・rulesync generate-commands が走るのを避ける。
hash_cmd() { if command -v sha1sum >/dev/null; then sha1sum; else shasum -a 1; fi; }
calculate_apm_hash() {
  for f in "$HOME/.apm/apm.yml" "$HOME/.apm/apm.lock.yaml"; do
    [ -f "$f" ] && echo "$f $(hash_cmd < "$f")"
  done | hash_cmd
}
apm_hash=$(calculate_apm_hash)
if [ "$(cat "$state_dir/apm-hash" 2>/dev/null)" != "$apm_hash" ]; then
  echo "Running mise run apm:install..."
  if CHEZMOI_SOURCE_DIR=$source_dir mise run apm:install; then
    # install が lockfile を更新する場合があるため、完了後の内容をマーカーへ保存する。
    calculate_apm_hash > "$state_dir/apm-hash" || exit 1
  else
    exit 1
  fi
else
  echo "APM manifest and lockfile are unchanged; skipping skill installation."
fi
# 5) rulesync generate:
#    rulesync のソース（プロジェクト直下の .rulesync/ + rulesync.jsonc、および
#    グローバルの ~/.config/rulesync/）に差分があるときだけハッシュマーカーで判定して走らせる。
rulesync_hash=$(
  {
    find "$source_dir/.rulesync" "$HOME/.config/rulesync/.rulesync" -type f 2>/dev/null
    for f in "$source_dir/rulesync.jsonc" "$HOME/.config/rulesync/rulesync.jsonc"; do
      [ -f "$f" ] && echo "$f"
    done
  } | sort | while IFS= read -r f; do
    # 「パス + 内容ハッシュ」を1行にすることでファイル境界を曖昧にせず（連結衝突を防ぎ）、
    # 追加/削除/リネーム/内容変更のいずれも検知する。
    echo "$f $(hash_cmd < "$f")"
  done | hash_cmd
)
if [ "$(cat "$state_dir/rulesync-hash" 2>/dev/null)" != "$rulesync_hash" ]; then
  echo "Running mise run rulesync:generate..."
  if CHEZMOI_SOURCE_DIR=$source_dir mise run rulesync:generate; then
    # マーカー書き込み失敗（state_dir が書込み不可/容量不足）も検知して警告する。
    # 未検知だと毎回の apply で無駄に再生成され続けるため。
    if ! printf '%s' "$rulesync_hash" > "$state_dir/rulesync-hash" 2>/dev/null; then
      echo "warning: rulesync-hash マーカーの書き込みに失敗しました（次回 apply で再生成されます）"
    fi
  else
    echo "warning: 'mise run rulesync:generate' に失敗しました。次回 chezmoi apply 時に再試行します"
  fi
fi
""",
]
command = "bash"
