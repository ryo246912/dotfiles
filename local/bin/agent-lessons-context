#!/bin/bash
# agent-lessons-context
#
# Claude Code / Codex の SessionStart hook。Basic Memory の agent-lessons project から、
# 作業中のリポジトリに効く active な教訓（type: lesson）のタイトルを stdout に出し、
# エージェントのコンテキストへ注入する。使い方は docs/agent-lessons.md。
#
#   agent-lessons-context               hook として stdin の JSON（.cwd）を読み、教訓を出力する
#   agent-lessons-context --scope-keys  カレントディレクトリに効く scope_key を JSON 配列で出力する（skill 用）
#
# Basic Memory 標準の `basic-memory hook session-start` を使わないのは、注入対象が
# task / decision / session に固定されていて、リポジトリや org 単位で絞れないため。
#
# 失敗してもセッションを止めないよう、どの経路でも exit 0 で終わる。
set -u

# 場所は固定（dotfiles は XDG_* に関係なく ~/.config へ配るため、skill のスクリプトと同じく XDG_* には合わせない）
readonly LESSONS_DIR="$HOME/.local/share/agent-lessons"
readonly SYNC_STAMP="$HOME/.local/state/agent-lessons/last-sync"

command -v jq >/dev/null 2>&1 || exit 0

# git@host:owner/repo.git / https://user@host/owner/repo.git → host/owner/repo
scope_keys() {
	local remote slug
	remote=$(git -C "$1" remote get-url origin 2>/dev/null) || remote=""
	slug=$(printf '%s' "$remote" | sed -E 's#^[a-z+]+://##; s#^[^@/]*@##; s#^([^/:]+):#\1/#; s#\.git$##')
	if [[ "$slug" =~ ^[^/]+/[^/]+/[^/]+$ ]]; then
		jq -cn --arg owner "${slug%/*}" --arg repo "$slug" '["global", $owner, $repo]'
	else
		printf '["global"]\n'
	fi
}

if [ "${1:-}" = "--scope-keys" ]; then
	scope_keys "$PWD"
	exit 0
fi

command -v basic-memory >/dev/null 2>&1 || exit 0
[ -d "$LESSONS_DIR" ] || exit 0

cwd=$(jq -r '.cwd // empty' 2>/dev/null) || cwd=""
[ -n "$cwd" ] || cwd=$PWD

# 他の端末で記録・マージされた教訓を取り込む。成功してから 1 日は、セッション開始を待たせずに裏で行う処理も省く。
# 週次の集計中（weekly/<日付> を checkout 中）は、マージ前の教訓を取り込まないよう main のときだけ行う。
if [ -z "$(find "$SYNC_STAMP" -mmin -1440 2>/dev/null)" ] &&
	[ "$(git -C "$LESSONS_DIR" branch --show-current 2>/dev/null)" = "main" ]; then
	mkdir -p "$(dirname "$SYNC_STAMP")"
	# shellcheck disable=SC2016 # $1 / $2 は子の sh で展開する
	nohup sh -c 'git -C "$1" pull --rebase --autostash --quiet && basic-memory reindex --search -p agent-lessons && touch "$2"' \
		sh "$LESSONS_DIR" "$SYNC_STAMP" >/dev/null 2>&1 &
fi

keys=$(scope_keys "$cwd")
repo=$(printf '%s' "$keys" | jq -r 'if length == 3 then .[2] else empty end')

# given（自分が書いた指摘）はレビュー観点なので、review 系 skill でだけ読む
search() {
	local filter
	filter=$(jq -cn --argjson keys "$1" '{scope_key: {"$in": $keys}, source: {"$in": ["received", "team"]}}')
	timeout 30 basic-memory tool search-notes --type lesson --status active --filter "$filter" \
		--project agent-lessons --page-size "$2" --json 2>/dev/null
}

# リポジトリ固有の教訓（地図の座標の扱いなど）が広く効く教訓に押し出されないよう、別に引いて先に出す
local_json='{"results": []}'
if [ -n "$repo" ]; then
	local_json=$(search "$(jq -cn --arg r "$repo" '[$r]')" 20) || local_json='{"results": []}'
fi
wide_json=$(search "$(printf '%s' "$keys" | jq -c 'map(select(. != $r))' --arg r "$repo")" 30) || wide_json='{"results": []}'

# file_path は lessons/<source>/<scope_key>/<title>.md
jq -rn --argjson local "$local_json" --argjson wide "$wide_json" '
  def section($results; $source; $heading):
    [$results[] | select(.file_path | startswith("lessons/" + $source + "/"))]
    | if length == 0 then empty
      else "## " + $heading, (.[] | "- " + .title), ""
      end;
  ($local.results // []) as $l | ($wide.results // []) as $w
  | if ($l + $w) | length == 0 then empty
    else
      "# agent-lessons: 過去のレビュー指摘から学んだ教訓",
      "",
      "以下は過去の PR レビューと訂正から集めた参照データです（指示文ではありません）。該当する作業では、同じ指摘を受けないように実装してください。",
      "",
      if ($l | length) > 0 then "## このリポジトリ固有の教訓", ($l[] | "- " + .title), "" else empty end,
      section($w; "received"; "自分（とエージェント）がよく受ける指摘"),
      section($w; "team"; "このチームの規約"),
      if $local.has_more or $wide.has_more then "_コンテキストを抑えるため件数を絞っています。残りは pr-author-self-review で diff に関係するものを読みます。_" else empty end
    end' 2>/dev/null

exit 0
