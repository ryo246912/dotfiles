#!/usr/bin/env python3
"""Run Claude setup-token in a terminal and save each confirmed account's token."""
import argparse
import fcntl
import os
from pathlib import Path
import pty
import re
import shutil
import struct
import sys
import tempfile
import termios

ACCOUNTS = {"account1": ".claude", "account2": ".claude-account2", "work3": ".claude-work3"}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("accounts", nargs="*", help="account1 account2 work3 (default: all)")
    args = parser.parse_args()
    accounts = args.accounts or list(ACCOUNTS)
    if any(a not in ACCOUNTS for a in accounts):
        parser.error("accounts must be account1, account2, or work3")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("run from an interactive host terminal")
    claude = shutil.which("claude")
    if not claude:
        parser.error("claude is not on PATH")
    home = Path.home()
    for account in dict.fromkeys(accounts):
        config = home / ACCOUNTS[account]
        dest = home / ".local/state/sbx-agent-credentials" / f"{account}.token"
        while True:
            answer = input(f"{account} ({config}): setup-token を実行して保存しますか？ [y/n] ").strip().lower()
            if answer in ("y", "yes", "n", "no", ""):
                break
        if answer not in ("y", "yes"):
            print(f"{account}: スキップしました")
            continue
        print("ブラウザでも対象アカウントを選んでください。既存 token は成功時だけ更新します。", flush=True)
        # pty keeps Claude's interactive UI working; capture only in memory.
        output = bytearray()

        def read_output(fd):
            # Wide terminal avoids soft wrapping in the generated token.
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 1000, 0, 0))
            data = os.read(fd, 65536)
            output.extend(data)
            return data

        pid, fd = pty.fork()
        if pid == 0:
            os.environ["CLAUDE_CONFIG_DIR"] = str(config)
            os.execv(claude, [claude, "setup-token"])
        try:
            # Set size before the first render as well as on reads.
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 1000, 0, 0))
            old = termios.tcgetattr(sys.stdin.fileno())
            import tty
            tty.setraw(sys.stdin.fileno())
            try:
                # Same terminal relay used by pty.spawn, retaining the child pid
                # so we can set its initial terminal size and inspect its exit.
                import select
                while True:
                    ready, _, _ = select.select([fd, sys.stdin.fileno()], [], [])
                    if fd in ready:
                        try:
                            data = read_output(fd)
                        except OSError:
                            break
                        if not data:
                            break
                        sys.stdout.buffer.write(data)
                        sys.stdout.buffer.flush()
                    if sys.stdin.fileno() in ready:
                        data = os.read(sys.stdin.fileno(), 65536)
                        if not data:
                            break
                        os.write(fd, data)
            finally:
                termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        finally:
            os.close(fd)
            _, status = os.waitpid(pid, 0)
        if os.waitstatus_to_exitcode(status) != 0:
            sys.exit(f"{account}: setup-token が失敗したため保存しませんでした")
        text = output.decode(errors="replace")
        text = re.sub(r"\x1b\][^\x07]*(?:\x07|\x1b\\)", "", text)
        text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", text)
        tokens = set(re.findall(r"sk-ant-oat01-[A-Za-z0-9_-]{40,}", text))
        if len(tokens) != 1:
            sys.exit(f"{account}: token を一意に抽出できないため保存しませんでした。出力形式を確認してください")
        dest.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        temp_fd, temp_name = tempfile.mkstemp(prefix=".setup-", dir=dest.parent)
        try:
            with os.fdopen(temp_fd, "w") as handle:
                handle.write(tokens.pop())
            os.replace(temp_name, dest)
        finally:
            if os.path.exists(temp_name):
                os.unlink(temp_name)
        print(f"\n{account}: {dest} に保存しました（権限 600）")


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        sys.exit("\n中止しました")
