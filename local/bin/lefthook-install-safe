#!/bin/sh
# install は設定不在時に lefthook.yml を上書きするため、安定したコピーを渡す。
set -eu
command -v lefthook >/dev/null 2>&1 || exit 0
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
config=${LEFTHOOK_CONFIG:-}
if [ -z "$config" ]; then
	# Lefthook 2.2.1 の loadFirstMain と同じ探索順。
	for extension in yml yaml json jsonc toml; do
		for name in lefthook .lefthook .config/lefthook; do
			if [ -f "$name.$extension" ]; then
				config=$name.$extension
				break 2
			fi
		done
	done
fi
[ -n "$config" ] && [ -f "$config" ] || exit 0
snapshot_dir=$(mktemp -d "${TMPDIR:-/tmp}/lefthook-install.XXXXXXXX")
trap 'rm -rf "$snapshot_dir"' EXIT
trap 'exit 1' HUP INT TERM
snapshot="$snapshot_dir/config.${config##*.}"
# コピー前に checkout 等で削除された場合も install は実行しない。
cp "$config" "$snapshot" || exit 0
LEFTHOOK_CONFIG="$snapshot" lefthook install "$@"
