#!/usr/bin/env bash
#
# sbx-agent: Docker Sandboxes (sbx) 経由で AI Agent を起動するラッパー
#
# devcontainer で行っていた「ホストの設定をマウントし、git / agent を設定した隔離環境で
# AI エージェントを動かす」を Docker Sandboxes で再現する。
# devcontainer 側の対応表と再現できていない項目は docs/docker-sandboxes.md を参照。
#
# Usage:
#   sbx-agent <agent> [options] [-- <agent-args>...]
#
#   agent   : claude | codex | copilot | shell など sbx が対応する agent 名
#
# Options:
#   --name NAME        sandbox 名（既定: <repo>-<branch>-<agent>）
#   --name-suffix SFX  既定の sandbox 名の末尾に付ける識別子（--config-dir と併用する）
#   --workspace DIR    primary workspace（既定: カレントディレクトリ）
#   --config-dir DIR   agent の設定ディレクトリ（既定: agent ごとの標準パス）
#   --mount PATH       追加 workspace（複数指定可、`:ro` 接尾辞で read-only）
#   --branch NAME      branch mode で起動する（auto を渡すと sbx が命名）
#   --template REF     sandbox template の OCI 参照（既定: sbx-agent:local）
#   --no-template      template を指定せず sbx の既定 template で起動する
#   --publish SPEC     ポート公開（host:sandbox、複数指定可）
#   --skills MODE      共有 skills store の扱い（off|readonly|readwrite、既定: readonly）
#   --static-mcp NAMES ホストに登録済みの MCP サーバを読み込む（`,` 区切り、複数指定可）
#                      登録は `mise run sandbox:mcp` / `sbx mcp add`。認証はホスト側で一度だけ
#   --cpus N           CPU 数
#   --memory SIZE      メモリ上限（例: 8g）
#   --rm               agent セッション終了時に sandbox を削除する
#   --new              既存 sandbox を削除してから新規作成する
#   --no-config        ホスト設定の自動マウント・自動 git 設定を行わない
#   --no-host-bridge   ホスト連携（mac-host への SSH 経路・crit ポート公開）を設定しない
#   -h, --help         このヘルプを表示
#
# Environment:
#   SBX_AGENT_MOUNTS    追加 workspace を `,` 区切りで指定（--mount と併用可）
#   SBX_AGENT_TEMPLATE  既定で使う sandbox template（未指定なら sbx-agent:local）
#   SBX_AGENT_STATIC_MCP  --static-mcp の既定値（`,` 区切り）
#
# 参考: https://docs.docker.com/reference/cli/sbx/
set -uo pipefail

log_info() { printf '\033[0;34m[INFO]\033[0m %s\n' "$1" >&2; }
log_warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$1" >&2; }
log_error() { printf '\033[0;31m[ERROR]\033[0m %s\n' "$1" >&2; }

# ファイル先頭のコメントブロックをそのままヘルプとして出す。
# 行番号を決め打ちするとヘッダを増やすたびにずれるため、最初の非コメント行までを出力する。
show_usage() {
    awk 'NR == 1 { next }
         /^#/ { sub(/^# ?/, ""); print; next }
         { exit }' "$0"
}

if [[ $# -eq 0 ]]; then
    show_usage
    exit 1
fi

case "$1" in
    -h | --help)
        show_usage
        exit 0
        ;;
    -*)
        log_error "最初の引数には agent 名を指定してください (例: sbx-agent claude)"
        exit 1
        ;;
esac

AGENT="$1"
shift

SANDBOX_NAME=""
NAME_SUFFIX=""
WORKSPACE="$PWD"
CONFIG_DIR=""
BRANCH=""
TEMPLATE=""
NO_TEMPLATE=false
SKILLS="readonly"
CPUS=""
MEMORY=""
FORCE_NEW=false
REMOVE_ON_EXIT=false
MOUNT_CONFIG=true
HOST_BRIDGE=true
EXTRA_MOUNTS=()
PUBLISH_PORTS=()
STATIC_MCP=()
AGENT_ARGS=()

expand_tilde() {
    local path="$1"
    path="${path/#\~/$HOME}"
    printf '%s' "${path//\$HOME/$HOME}"
}

# symlink を 1 段だけ解決する。
# macOS の readlink には -f が無い環境があるため、GNU coreutils に依存しない形で辿る。
resolve_symlink() {
    local path="$1" target
    target=$(readlink "$path" 2>/dev/null) || return 1
    [[ "$target" != /* ]] && target="$(cd "$(dirname "$path")" 2>/dev/null && pwd)/$target"
    printf '%s' "$target"
}

# 候補が「この dotfiles リポジトリ」かどうかを判定する。
# mise.toml と .git があるだけでは、同じ構成の別プロジェクトを誤認する
# （config/devcontainer のように mise.toml を持つサブディレクトリも引っかかる）。
# このリポジトリは mise.toml の [dotfiles] で配置先を宣言しているので、それを目印にする。
looks_like_dotfiles_repo() {
    [[ -f "$1/mise.toml" && -e "$1/.git" ]] || return 1
    # [dotfiles] と [dotfiles."~/.config"] の両方に当てる
    grep -q '^\[dotfiles[].]' "$1/mise.toml" 2>/dev/null
}

# dotfiles リポジトリのチェックアウト先を特定する。
# mise の [dotfiles] は ~/.config・~/.claude・~/.codex を symlink-each で配置するため、
# それらをマウントしても中身はリポジトリを指す symlink のままになる。sbx はホストと同じ
# 絶対パスへマウントするので、リポジトリ自体も同じパスで渡せば全ての symlink が解決する。
find_dotfiles_repo() {
    local candidate probe target dir
    # 配置済み symlink のリンク先から逆算するのが最も確実（「実際にリンク先になっている
    # ツリー」が分かるため）なので、環境変数や既定パスより先に試す。
    for probe in "${HOME}/.config/zsh/main.zsh" "${HOME}/.config/git/gitignore" "${HOME}/.claude/settings.json"; do
        [[ -L "$probe" ]] || continue
        target=$(resolve_symlink "$probe") || continue
        dir=$(dirname "$target")
        while [[ "$dir" != "/" && "$dir" != "." ]]; do
            if looks_like_dotfiles_repo "$dir"; then
                printf '%s' "$dir"
                return 0
            fi
            dir=$(dirname "$dir")
        done
    done
    # symlink が 1 つも見つからない（dotfiles 未適用など）場合のフォールバック。
    # DOTFILES_DIR はクォート付きで export されている（例: DOTFILES_DIR="~/foo"）ことが
    # あるため、expand_tilde で ~ を展開してから判定する。
    for candidate in "${DOTFILES_DIR:-}" "${HOME}/dotfiles"; do
        [[ -n "$candidate" ]] || continue
        candidate=$(expand_tilde "$candidate")
        if looks_like_dotfiles_repo "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

require_value() {
    [[ $2 -gt 0 ]] || {
        log_error "$1 には値が必要です"
        exit 1
    }
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --name)
            shift && require_value --name $#
            SANDBOX_NAME="$1"
            ;;
        --name=*) SANDBOX_NAME="${1#*=}" ;;
        --name-suffix)
            shift && require_value --name-suffix $#
            NAME_SUFFIX="$1"
            ;;
        --name-suffix=*) NAME_SUFFIX="${1#*=}" ;;
        --workspace)
            shift && require_value --workspace $#
            WORKSPACE="$1"
            ;;
        --workspace=*) WORKSPACE="${1#*=}" ;;
        --config-dir)
            shift && require_value --config-dir $#
            CONFIG_DIR="$1"
            ;;
        --config-dir=*) CONFIG_DIR="${1#*=}" ;;
        --branch)
            shift && require_value --branch $#
            BRANCH="$1"
            ;;
        --branch=*) BRANCH="${1#*=}" ;;
        --template)
            shift && require_value --template $#
            TEMPLATE="$1"
            ;;
        --template=*) TEMPLATE="${1#*=}" ;;
        --no-template) NO_TEMPLATE=true ;;
        --mount)
            shift && require_value --mount $#
            EXTRA_MOUNTS+=("$1")
            ;;
        --mount=*) EXTRA_MOUNTS+=("${1#*=}") ;;
        --publish)
            shift && require_value --publish $#
            PUBLISH_PORTS+=("$1")
            ;;
        --publish=*) PUBLISH_PORTS+=("${1#*=}") ;;
        --skills)
            shift && require_value --skills $#
            SKILLS="$1"
            ;;
        --skills=*) SKILLS="${1#*=}" ;;
        --static-mcp)
            shift && require_value --static-mcp $#
            STATIC_MCP+=("$1")
            ;;
        --static-mcp=*) STATIC_MCP+=("${1#*=}") ;;
        --cpus)
            shift && require_value --cpus $#
            CPUS="$1"
            ;;
        --cpus=*) CPUS="${1#*=}" ;;
        --memory)
            shift && require_value --memory $#
            MEMORY="$1"
            ;;
        --memory=*) MEMORY="${1#*=}" ;;
        --rm) REMOVE_ON_EXIT=true ;;
        --new) FORCE_NEW=true ;;
        --no-config) MOUNT_CONFIG=false ;;
        --no-host-bridge) HOST_BRIDGE=false ;;
        -h | --help)
            show_usage
            exit 0
            ;;
        --)
            shift
            AGENT_ARGS+=("$@")
            break
            ;;
        *) AGENT_ARGS+=("$1") ;;
    esac
    shift
done

# sandbox 内の固定パス・固定ポート
# scripts は Dockerfile.sandbox が image 内の agent ホーム配下へ COPY している
readonly SANDBOX_SCRIPTS_DIR="/home/agent/.config/devcontainer/scripts"
readonly SANDBOX_POST_CREATE="${SANDBOX_SCRIPTS_DIR}/sandbox-post-create.sh"
# crit / plannotator は sandbox 内では固定ポートで待ち受け、host port は sbx に自動採番させる
readonly CRIT_SANDBOX_PORT=7842
readonly PLANNOTATOR_SANDBOX_PORT=19433
# mise run sandbox:build-template が作るローカル template の既定名
readonly DEFAULT_TEMPLATE="sbx-agent:local"

if ! command -v sbx >/dev/null 2>&1; then
    log_error "sbx コマンドが見つかりません。'mise install' で導入してください（docs/docker-sandboxes.md 参照）"
    exit 1
fi

if [[ ${#STATIC_MCP[@]} -eq 0 ]] && [[ -n "${SBX_AGENT_STATIC_MCP:-}" ]]; then
    STATIC_MCP+=("$SBX_AGENT_STATIC_MCP")
fi
# `,` 区切りを展開して重複を除く
MCP_SERVERS=()
for _spec in ${STATIC_MCP[@]+"${STATIC_MCP[@]}"}; do
    IFS=',' read -ra _names <<< "$_spec"
    for _name in "${_names[@]}"; do
        [[ -z "$_name" ]] && continue
        _seen=false
        for _existing in ${MCP_SERVERS[@]+"${MCP_SERVERS[@]}"}; do
            [[ "$_existing" == "$_name" ]] && _seen=true && break
        done
        [[ "$_seen" == false ]] && MCP_SERVERS+=("$_name")
    done
done

# template は常に DEFAULT_TEMPLATE を使う。--template / SBX_AGENT_TEMPLATE で上書きでき、
# --no-template で sbx の既定 template に戻せる。未ビルドなら sbx create が失敗し、
# そこで原因と build 手順を出す。
if [[ "$NO_TEMPLATE" == true ]]; then
    [[ -n "$TEMPLATE" ]] && log_warn "--no-template が指定されたため --template を無視します"
    TEMPLATE=""
elif [[ -z "$TEMPLATE" ]]; then
    TEMPLATE="${SBX_AGENT_TEMPLATE:-$DEFAULT_TEMPLATE}"
fi

case "$SKILLS" in
    off | readonly | readwrite) ;;
    *)
        log_error "--skills には off / readonly / readwrite のいずれかを指定してください: $SKILLS"
        exit 1
        ;;
esac

# agent ごとの設定ディレクトリ（devcontainer.json で bind mount していたもの）と、
# sandbox 内でそれを参照させる環境変数。sbx はホストと同じ絶対パスに workspace を
# マウントするため、sandbox 内の $HOME はホストとは別物になる。
AGENT_CONFIG_ENV=""
case "$AGENT" in
    claude)
        : "${CONFIG_DIR:=${HOME}/.claude}"
        AGENT_CONFIG_ENV="CLAUDE_CONFIG_DIR"
        ;;
    codex)
        : "${CONFIG_DIR:=${HOME}/.codex}"
        AGENT_CONFIG_ENV="CODEX_HOME"
        ;;
    copilot) : "${CONFIG_DIR:=${HOME}/.copilot}" ;;
esac
[[ -n "$CONFIG_DIR" ]] && CONFIG_DIR=$(expand_tilde "$CONFIG_DIR")

# workspace を絶対パス化する（sbx はホストの絶対パスをそのまま sandbox 内にマウントする）
WORKSPACE=$(cd "$(expand_tilde "$WORKSPACE")" 2>/dev/null && pwd) || {
    log_error "workspace が見つかりません: $WORKSPACE"
    exit 1
}

# sandbox 名: <repo>-<branch>-<agent>
# sbx の sandbox 名は hostname 相当のため、英数字とハイフンのみに正規化する
sanitize_name() {
    printf '%s' "$1" \
        | tr -d '\n' \
        | tr '[:upper:]' '[:lower:]' \
        | sed -E 's#[^a-z0-9]+#-#g; s#-+#-#g; s#^-+##; s#-+$##'
}

if [[ -z "$SANDBOX_NAME" ]]; then
    repo=$(git -C "$WORKSPACE" rev-parse --show-toplevel 2>/dev/null) || repo="$WORKSPACE"
    branch=$(git -C "$WORKSPACE" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
    # commit の無いリポジトリでは --abbrev-ref HEAD が "HEAD" を返す
    [[ -z "$branch" || "$branch" == "HEAD" ]] && branch="main"
    SANDBOX_NAME=$(sanitize_name "$(basename "$repo")-${branch}-${AGENT}${NAME_SUFFIX:+-$NAME_SUFFIX}")
    [[ -z "$SANDBOX_NAME" ]] && SANDBOX_NAME="sbx-${AGENT}"
fi
# sandbox 名は 63 文字以内で、末尾がハイフン・ピリオドでないことが要求される
if ((${#SANDBOX_NAME} > 63)); then
    SANDBOX_NAME="${SANDBOX_NAME:0:63}"
    SANDBOX_NAME="${SANDBOX_NAME%%[-.]}"
fi

# ---------------------------------------------------------------------------
# 追加 workspace の組み立て
#   - 環境変数 SBX_AGENT_MOUNTS（`,` 区切り）→ --mount → ホスト設定 → agent 設定 の順
#   - `<path>:ro` は sbx の read-only マウント指定なので接尾辞として温存する
# ---------------------------------------------------------------------------
MOUNTS=()
add_mount() {
    local spec="$1"
    local path="$spec"
    local suffix=""

    if [[ "$spec" == *:ro ]]; then
        path="${spec%:ro}"
        suffix=":ro"
    fi

    path=$(expand_tilde "$path")
    if [[ ! -e "$path" ]]; then
        log_warn "存在しないためマウントをスキップします: $path"
        return
    fi

    local existing
    for existing in ${MOUNTS[@]+"${MOUNTS[@]}"}; do
        [[ "${existing%:ro}" == "$path" ]] && return
    done

    MOUNTS+=("${path}${suffix}")
}

if [[ -n "${SBX_AGENT_MOUNTS:-}" ]]; then
    # `:` は read-only 指定の `:ro` と衝突するため `,` 区切りにしている
    IFS=',' read -ra _env_mounts <<< "$SBX_AGENT_MOUNTS"
    for spec in "${_env_mounts[@]}"; do
        [[ -n "$spec" ]] && add_mount "$spec"
    done
fi

for spec in ${EXTRA_MOUNTS[@]+"${EXTRA_MOUNTS[@]}"}; do
    add_mount "$spec"
done

if [[ "$MOUNT_CONFIG" == true ]]; then
    # devcontainer.json の mounts に対応するホスト設定
    add_mount "${HOME}/.config/git/config:ro"
    add_mount "${HOME}/.config/git/gitignore:ro"
    add_mount "${HOME}/.aws/config:ro"
    add_mount "${HOME}/.agents:ro"
    add_mount "${HOME}/.ssh/known_hosts:ro"
    add_mount "${HOME}/.claude.json:ro"
    # nvim 設定は read-only。書き込み可にすると agent がホストの init.lua を書き換えられてしまう。
    # lazy.nvim の lockfile は AI_AGENT が立っているとき stdpath("state") 側へ逃がしている
    # （config/nvim/init.lua 参照）ため、read-only でもプラグイン管理は動く。
    add_mount "${HOME}/.config/nvim:ro"
    # gh の設定（~/.config/gh）はマウントしない。hosts.yml に OAuth トークンが平文で入っており、
    # sandbox 内の agent がそれを読めてしまう。GitHub 認証は sbx secret（ホスト側プロキシが
    # 送信時に注入する）で行う。
    [[ -n "$CONFIG_DIR" ]] && add_mount "$CONFIG_DIR"
    # 上のホスト設定は mise の [dotfiles] が symlink-each で配置しているため、中身は
    # dotfiles リポジトリを指す symlink になっている。リポジトリも同じ絶対パスへ
    # read-only で渡さないと、sandbox 内では全てリンク切れになる。
    if dotfiles_repo=$(find_dotfiles_repo); then
        # 省略するのは workspace がリポジトリ root そのもののときだけ（既に rw でマウント
        # 済み）。サブディレクトリを workspace にした場合は root が見えないため、
        # ~/.config 配下の symlink を解決するにはリポジトリの追加マウントが必要になる。
        if [[ "$WORKSPACE" != "$dotfiles_repo" ]]; then
            add_mount "${dotfiles_repo}:ro"
        fi
    else
        log_warn "dotfiles リポジトリが見つからないため、ホスト設定の symlink が sandbox 内で解決できません"
        log_warn "  既定の ~/dotfiles 以外に clone している場合は DOTFILES_DIR を export してください"
    fi

    # ~/.claude-account2 などは skills / agents / plugins / projects を ../.claude/<entry> への
    # symlink で共有している（devcontainer の post-create.sh が作る）。sandbox 内では
    # CLAUDE_CONFIG_DIR がこのホストのパスを指し、sbx の共有 skills store
    # （/home/agent/.claude/skills）は読まれないため、リンク先もマウントしないと
    # skills などがリンク切れで見つからなくなる。devcontainer と同じく書き込み可で渡す。
    # 対象は post-create.sh が共有する entry に限る（任意の symlink を辿ると、認証情報など
    # 意図しないホストのファイルを書き込み可で sandbox に渡しかねないため）。
    # 最終的に dotfiles リポジトリ内を指すもの（~/.claude/settings.json など symlink-each で
    # 配置したもの）は read-only にする。書き込み可で渡すと、上の `${dotfiles_repo}:ro` より
    # 子のマウントが優先され、sandbox からホストの dotfiles を書き換えられてしまう。
    if [[ -n "$CONFIG_DIR" && -d "$CONFIG_DIR" ]]; then
        config_dir_real=$(cd "$CONFIG_DIR" && pwd -P)
        dotfiles_repo_real=""
        [[ -n "${dotfiles_repo:-}" ]] && dotfiles_repo_real=$(cd "$dotfiles_repo" && pwd -P)
        for shared_entry in projects settings.json agents skills plugins; do
            entry="${CONFIG_DIR}/${shared_entry}"
            [[ -L "$entry" && -e "$entry" ]] || continue
            target=$(resolve_symlink "$entry") || continue
            # 親ディレクトリだけ正規化し、最後の要素は symlink のまま渡す
            # （リンク先がさらに symlink でも、その経路ごと sandbox 内で解決させるため）
            target_parent=$(cd "$(dirname "$target")" 2>/dev/null && pwd -P) || continue
            target="${target_parent}/$(basename "$target")"
            [[ "$target" == "$config_dir_real"/* ]] && continue
            # sbx がマウントできるのはディレクトリと通常ファイルだけで、ファイルへの symlink
            # （~/.claude/settings.json など）は "exists but is not a directory" で作成ごと失敗する。
            # 共有が要るのは skills などのディレクトリなので、それ以外は渡さない。
            [[ -d "$target" ]] || continue

            # symlink の連鎖を辿りきった実体の場所で read-only にするか決める
            final="$target"
            for _ in 1 2 3 4 5 6 7 8; do
                [[ -L "$final" ]] || break
                final=$(resolve_symlink "$final") || break
            done
            final_parent=$(cd "$(dirname "$final")" 2>/dev/null && pwd -P) || continue
            final="${final_parent}/$(basename "$final")"
            if [[ -n "$dotfiles_repo_real" && "$final" == "$dotfiles_repo_real"/* ]]; then
                add_mount "${target}:ro"
            else
                add_mount "$target"
            fi
        done
    fi
fi

# ホスト連携: mac-host への SSH に使う devcontainer 専用鍵
# （個人鍵は渡さない。署名はこれとは別に ssh-agent forwarding を使う）
HOST_SSH_KEY="${HOME}/.ssh/id_docker_devcontainer"
if [[ "$HOST_BRIDGE" == true ]] && [[ -f "$HOST_SSH_KEY" ]]; then
    add_mount "${HOST_SSH_KEY}:ro"
else
    HOST_SSH_KEY=""
fi

# workspace が linked worktree の場合、.git file は common git dir を絶対パスで参照する。
# sbx はホストと同じ絶対パスにマウントするため、これも渡さないと sandbox 内で git が壊れる
# （公式ドキュメントの "Host worktree" の制限を回避する方法。docs/docker-sandboxes.md 参照）。
if grep -q '^gitdir: [^/]' "${WORKSPACE}/.git" 2>/dev/null; then
    log_warn "workspace が relative-paths 形式の worktree のため、sandbox 内で git が使えません"
elif common_git_dir=$(git -C "$WORKSPACE" rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
    [[ "$common_git_dir" != "${WORKSPACE}/.git" ]] && add_mount "$common_git_dir"
fi

# ---------------------------------------------------------------------------
# sandbox の環境変数
#   devcontainer.json の remoteEnv と post-create.sh の git 設定に対応する。
#   git 設定は GIT_CONFIG_COUNT/KEY/VALUE で注入する（sandbox 内の $HOME は別物なので
#   ホストの ~/.config/git/config は自動では読まれない）。
# ---------------------------------------------------------------------------
ENV_ARGS=()
add_env() { ENV_ARGS+=(--env "$1=$2"); }

GIT_CONFIG_PAIRS=()
add_git_config() { GIT_CONFIG_PAIRS+=("$1" "$2"); }

add_env AI_AGENT 1
# claude が xterm-256color を必要とするため TERM を設定する
add_env TERM xterm-256color
add_env HOST_USER "${USER:-}"
# devcontainer 専用の lint hook 設定を使う
add_env LEFTHOOK_CONFIG lefthook.local.yml
# workspace の mise 設定を信頼し、非対話実行で trust prompt が出ないようにする
add_env MISE_TRUSTED_CONFIG_PATHS "/mise:$WORKSPACE"
if [[ "$HOST_BRIDGE" == true ]]; then
    # crit: ホストのブラウザから参照できるよう 0.0.0.0 にバインドし、固定ポートで待ち受ける
    add_env CRIT_HOST 0.0.0.0
    add_env CRIT_PORT "$CRIT_SANDBOX_PORT"
    # 非 loopback bind を許可する（sbx 側はホストの loopback にだけ publish する）
    add_env CRIT_ALLOW_UNAUTHENTICATED_NETWORK 1
    # sandbox 内では更新チェック不要
    add_env CRIT_NO_UPDATE_CHECK 1
    # plannotator: local mode の live annotation を有効にし、UI は mac-host への
    # SSH reverse tunnel でホストへ公開する
    add_env PLANNOTATOR_REMOTE 0
    add_env PLANNOTATOR_PORT "$PLANNOTATOR_SANDBOX_PORT"
    add_env PLANNOTATOR_BROWSER "${SANDBOX_SCRIPTS_DIR}/plannotator-browser"
    [[ -n "$HOST_SSH_KEY" ]] && add_env SBX_HOST_SSH_KEY "$HOST_SSH_KEY"
fi

# nvim / .claude.json はホスト設定のマウント（--no-config で止まる側）に属するため、
# ホスト連携の有無ではなく MOUNT_CONFIG で判定する。
if [[ "$MOUNT_CONFIG" == true ]]; then
    [[ -d "${HOME}/.config/nvim" ]] && add_env SBX_HOST_NVIM_CONFIG "${HOME}/.config/nvim"
    [[ -f "${HOME}/.claude.json" ]] && add_env SBX_HOST_CLAUDE_JSON "${HOME}/.claude.json"
fi

# 設定ディレクトリをマウントしていない場合は env を設定しない。
# マウントしていないホストのパスを指すと、sandbox 内に空ディレクトリを作らせるだけで
# ホストには永続化されず、agent の起動や設定の保存に失敗しうる。
# --no-config のときは下のマウント処理ごとスキップされるので、ここも併せて見る。
[[ "$MOUNT_CONFIG" == true && -n "$AGENT_CONFIG_ENV" && -n "$CONFIG_DIR" && -d "$CONFIG_DIR" ]] \
    && add_env "$AGENT_CONFIG_ENV" "$CONFIG_DIR"

if [[ "$MOUNT_CONFIG" == true ]]; then
    # ホストの gitconfig の url."git@github.com:".pushInsteadOf（push を SSH に寄せる）を打ち消し、
    # push も HTTPS のままにする。sandbox からは SSH で GitHub に出られず、gh の認証も
    # HTTPS にしか効かないため。下の insteadOf は push URL には適用されない（書き換えは連鎖しない）。
    # マッチ長が同じ pushInsteadOf は先に読まれた方が勝つため、必ず include.path より前に追加する。
    add_git_config 'url.https://github.com/.pushInsteadOf' 'https://github.com/'
    # ホストの gitconfig を include する（post-create.sh の include.path 相当）
    [[ -f "${HOME}/.config/git/config" ]] && add_git_config include.path "${HOME}/.config/git/config"
    [[ -f "${HOME}/.config/git/gitignore" ]] && add_git_config core.excludesfile "${HOME}/.config/git/gitignore"
    # ホストの gitconfig は pager と interactive.diffFilter に delta を指定しているが、
    # delta は sandbox のツールチェインに無いため、そのままだと git log / diff / show が
    # "cannot run delta" で失敗する。エージェント環境では pager は不要なので無効化する。
    #
    # pager.<cmd> は core.pager や PAGER より強いため、それらでは上書きできない。
    # GIT_PAGER は pager.<cmd> も上書きできる（実測で確認）ので env で渡す。
    # ホスト側が pager.blame 等を増やしても追従不要という利点もある。
    add_env GIT_PAGER cat
    add_git_config interactive.diffFilter cat

    # gh の認証情報を git の credential helper として使う。
    # URL 限定の helper は generic な credential.helper に「追加」されるだけなので、
    # 先に空文字でリストをリセットする。これをしないとホスト設定の
    # credential.helper = osxkeychain が先に試され、sandbox には無いため
    # "git: 'credential-osxkeychain' is not a git command" が毎回出る。
    # （GIT_CONFIG_VALUE が欠けても git は fatal にならないので、空値が
    #   環境変数として渡らない環境でも現状より悪化はしない）
    add_git_config 'credential.https://github.com.helper' ''
    add_git_config 'credential.https://github.com.helper' '!gh auth git-credential'
    add_git_config 'url.https://github.com/.insteadOf' 'git@github.com:'
    # 同じリポジトリの他 worktree は sandbox から見えないため、git gc の自動 prune が
    # それらを「消えた worktree」とみなしてホスト側の worktree を壊すのを防ぐ
    add_git_config gc.worktreePruneExpire never

    # コミット署名: sbx は SSH agent forwarding が既定で有効なので、ホストの秘密鍵を
    # sandbox に渡さずに署名できる。ホストのパスは sandbox 内に無いため、鍵ファイルでは
    # なく forwarded agent の公開鍵（key:: 形式）を指定する。
    #
    # macOS の ssh-agent は再起動直後は空で、~/.ssh/config の AddKeysToAgent は「SSH で
    # 鍵を使った時点」でしか登録しない。ホストの git が GPG 署名・HTTPS push だと SSH 鍵を
    # 使う機会が無く、ずっと空のままになる。Keychain にパスフレーズを保存済みの鍵は
    # 非対話で読み込めるので、空のときだけ試す（未保存なら何も起きない）。
    # ssh-add -L の終了コード: 0=鍵あり / 1=鍵なし / 2=agent に接続できない
    agent_rc=0
    ssh-add -L >/dev/null 2>&1 || agent_rc=$?
    if [[ $agent_rc -eq 1 && "$(uname -s)" == Darwin ]]; then
        ssh-add -q --apple-load-keychain >/dev/null 2>&1 || true
        agent_rc=0
        ssh-add -L >/dev/null 2>&1 || agent_rc=$?
    fi
    signing_pubkey=""
    [[ $agent_rc -eq 0 ]] && signing_pubkey=$(ssh-add -L 2>/dev/null | head -n 1)
    if [[ -n "$signing_pubkey" ]]; then
        add_git_config gpg.format ssh
        add_git_config user.signingkey "key::${signing_pubkey}"
        add_git_config commit.gpgsign true

        # 署名の検証（git log --show-signature 等）には allowed_signers が要る。無いと
        # "gpg.ssh.allowedSignersFile needs to be configured" になる。ホストの
        # ~/.config/git/allowed_signers に「email + 署名鍵」を冪等に追記し、同じ絶対パスで
        # read-only マウントして sandbox からも参照する（ホスト側の gitconfig も同じファイルを
        # 指しているので、sandbox で作った SSH 署名の commit をホストでも検証できる）。
        # email は workspace で有効な user.email（includeIf の work 用設定も反映される）。
        allowed_signers="${HOME}/.config/git/allowed_signers"
        signer_email=$(git -C "$WORKSPACE" config user.email 2>/dev/null) || signer_email=""
        if [[ -n "$signer_email" ]]; then
            signer_line="${signer_email} namespaces=\"git\" ${signing_pubkey}"
            mkdir -p "$(dirname "$allowed_signers")"
            touch "$allowed_signers"
            grep -qxF "$signer_line" "$allowed_signers" || printf '%s\n' "$signer_line" >>"$allowed_signers"
        fi
        if [[ -s "$allowed_signers" ]]; then
            add_mount "${allowed_signers}:ro"
            add_git_config gpg.ssh.allowedSignersFile "$allowed_signers"
        fi
    else
        # ホストの gitconfig が GPG 署名を有効にしていても、GPG 秘密鍵は sandbox に
        # 渡らないため commit が毎回失敗する。署名だけ無効化する。
        add_git_config commit.gpgsign false
        if [[ $agent_rc -eq 2 ]]; then
            log_warn "ホストの ssh-agent に接続できないため sandbox 内のコミット署名を無効化します"
            log_warn "  SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-（未設定）} を確認してください（tmux の古いセッションでは古いソケットを指していることがあります）"
        else
            log_warn "ホストの ssh-agent に鍵が無いため sandbox 内のコミット署名を無効化します"
            if [[ "$(uname -s)" == Darwin ]]; then
                log_warn "  一度だけ ssh-add --apple-use-keychain ~/.ssh/id_ed25519 を実行すると、以降は自動で読み込みます"
            else
                log_warn "  ssh-add ~/.ssh/id_ed25519 で鍵を登録してください"
            fi
        fi
    fi

    if [[ ${#GIT_CONFIG_PAIRS[@]} -gt 0 ]]; then
        add_env GIT_CONFIG_COUNT "$((${#GIT_CONFIG_PAIRS[@]} / 2))"
        idx=0
        while [[ $idx -lt ${#GIT_CONFIG_PAIRS[@]} ]]; do
            add_env "GIT_CONFIG_KEY_$((idx / 2))" "${GIT_CONFIG_PAIRS[idx]}"
            add_env "GIT_CONFIG_VALUE_$((idx / 2))" "${GIT_CONFIG_PAIRS[idx + 1]}"
            idx=$((idx + 2))
        done
    fi
fi

sandbox_exists() {
    sbx ls 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qx "$SANDBOX_NAME"
}

# ホスト側の前提条件を冪等に整える（sandbox を作るときだけ呼ぶ）。
# `mise run sandbox:setup` を手で打たなくても普段の起動で揃うようにしている。
ensure_host_prerequisites() {
    [[ "$HOST_BRIDGE" != true ]] && return 0

    # GitHub トークン: プロキシが注入するため agent は生トークンを読めない
    if ! sbx secret ls 2>/dev/null | grep -q '[[:space:]]github[[:space:]]'; then
        if command -v gh >/dev/null 2>&1 && gh auth token >/dev/null 2>&1; then
            sbx secret set github --command 'gh auth token' >/dev/null 2>&1 \
                && log_info "github の secret を登録しました"
        fi
    fi

    # mac-host への SSH。sandbox プロキシは host.docker.internal を localhost に
    # 書き換えて転送するため、許可ルールは localhost:<port> で書く
    if ! sbx policy ls 2>/dev/null | grep -q 'localhost:22'; then
        sbx policy allow network localhost:22 >/dev/null 2>&1 \
            && log_info "network policy に localhost:22 を追加しました"
    fi
}

# 停止・再起動で公開ポートは消えるため、アタッチ前に張り直す（sbx run の --publish は
# 既存 sandbox に対しては無視されるため、sbx ports を使う）
republish_ports() {
    [[ "$HOST_BRIDGE" != true ]] && return 0
    local port
    for port in "$CRIT_SANDBOX_PORT" "$PLANNOTATOR_SANDBOX_PORT"; do
        [[ -n "$(sandbox_host_port "$port")" ]] && continue
        sbx ports "$SANDBOX_NAME" --publish "$port" >/dev/null 2>&1 || true
    done
}

# 登録済みの MCP サーバを稼働中の sandbox へ読み込む（認証はホスト側で済んでいる）
load_static_mcp() {
    local name
    for name in ${MCP_SERVERS[@]+"${MCP_SERVERS[@]}"}; do
        sbx mcp load "$name" --sandbox "$SANDBOX_NAME" >/dev/null 2>&1 \
            || log_warn "MCP サーバ '$name' の読み込みに失敗しました（sbx mcp add で登録済みか確認してください）"
    done
}

# sandbox 内の指定ポートに割り当てられた host port を調べる
sandbox_host_port() {
    local sandbox_port="$1"
    sbx ports "$SANDBOX_NAME" 2>/dev/null \
        | awk -v p="$sandbox_port" 'NR > 1 && $3 == p { print $2; exit }'
}

# sbx には postCreateCommand が無いため、作成直後に sbx exec で初期化スクリプトを実行する
# （sbx exec -d は 0.45.0 で非対応になったので前景で実行する）
#
# --no-host-bridge でもスキップしない。初期化スクリプトの中身は nvim 設定の共有・生成物の
# 分離・lefthook といったホスト連携と無関係な処理も含んでおり、mac-host 関連は
# SBX_HOST_SSH_KEY が無ければスクリプト側で自動的にスキップされる。
run_post_create() {
    local -a env_args=()
    local crit_host_port
    if [[ "$HOST_BRIDGE" == true ]]; then
        crit_host_port=$(sandbox_host_port "$CRIT_SANDBOX_PORT")
        [[ -n "$crit_host_port" ]] && env_args+=(--env "SBX_CRIT_HOST_PORT=${crit_host_port}")
    fi

    log_info "sandbox の初期化を実行します"
    # `if ! cmd; then` の中で $? を読むと `! cmd` の結果（常に 0）になるため、先に保存する
    local rc=0
    sbx exec ${env_args[@]+"${env_args[@]}"} "$SANDBOX_NAME" \
        bash -lc "[ -x '$SANDBOX_POST_CREATE' ] || exit 97; '$SANDBOX_POST_CREATE'" || rc=$?
    if [[ $rc -ne 0 ]]; then
        if [[ $rc -eq 97 ]]; then
            log_warn "初期化スクリプトが sandbox 内に見つかりません。カスタム template を使っていない可能性があります"
            log_warn "  mise run sandbox:build-template でツールチェイン入りの template を作成してください"
        else
            log_warn "sandbox の初期化に失敗しました（終了コード: $rc）。セッションは続行します"
        fi
    fi
}

# --new は「作り直す」なので、既存があれば先に消す（消さないと sbx create が名前の衝突で
# 失敗し、結果として古い sandbox が再利用されてしまう）
if [[ "$FORCE_NEW" == true ]] && sandbox_exists; then
    log_info "既存の sandbox を削除します: $SANDBOX_NAME"
    if ! sbx rm --force "$SANDBOX_NAME"; then
        log_error "既存 sandbox の削除に失敗しました: $SANDBOX_NAME"
        exit 1
    fi
fi

if [[ "$FORCE_NEW" == true ]] || ! sandbox_exists; then
    ensure_host_prerequisites

    create_cmd=(sbx create --name="$SANDBOX_NAME" --skills="$SKILLS")
    for spec in ${MCP_SERVERS[@]+"${MCP_SERVERS[@]}"}; do
        create_cmd+=(--static-mcp "$spec")
    done
    # sbx create の --pull は既定が always なので、そのままでは `sbx-agent:local` のような
    # ローカルにしか無い template をレジストリから引こうとしてしまう（sbx 0.47.0 の
    # `sbx create --help` で確認。docs も `sbx run --pull never -t TAG` を例示している）。
    # never ではなく missing にするのは、SBX_AGENT_TEMPLATE にレジストリ上の参照を
    # 指定された場合に取得できなくなるのを避けるため（ローカルに有れば引かない）。
    [[ -n "$TEMPLATE" ]] && create_cmd+=(--template "$TEMPLATE" --pull missing)
    [[ -n "$CPUS" ]] && create_cmd+=(--cpus "$CPUS")
    [[ -n "$MEMORY" ]] && create_cmd+=(--memory "$MEMORY")
    if [[ "$HOST_BRIDGE" == true ]]; then
        # host port は固定せず sbx に採番させる（sandbox を複数同時起動しても衝突しない）。
        # 実際に割り当てられた port は作成後に sbx ports で調べて sandbox 内へ渡す。
        PUBLISH_PORTS+=("$CRIT_SANDBOX_PORT" "$PLANNOTATOR_SANDBOX_PORT")
    fi
    for spec in ${PUBLISH_PORTS[@]+"${PUBLISH_PORTS[@]}"}; do
        create_cmd+=(--publish "$spec")
    done
    create_cmd+=(${ENV_ARGS[@]+"${ENV_ARGS[@]}"})
    create_cmd+=("$AGENT" "$WORKSPACE")
    create_cmd+=(${MOUNTS[@]+"${MOUNTS[@]}"})

    log_info "sandbox を作成します: $SANDBOX_NAME"
    log_info "  workspace: $WORKSPACE"
    [[ ${#MOUNTS[@]} -gt 0 ]] && log_info "  追加 workspace: ${MOUNTS[*]}"
    [[ ${#PUBLISH_PORTS[@]} -gt 0 ]] && log_info "  公開ポート: ${PUBLISH_PORTS[*]}"

    if ! "${create_cmd[@]}"; then
        log_error "sandbox の作成に失敗しました"
        if [[ -n "$TEMPLATE" ]]; then
            # --pull missing なので、ローカルの image store に無い template は作成できない。
            # 「image が無い」系のエラーはここが原因なので、確認と作成の手順を出す。
            log_error "  template ($TEMPLATE) が原因かもしれません。確認するには:"
            log_error "    sbx template ls"
            log_error "  未ビルドなら: mise run sandbox:build-template"
            log_error "  template 無しで起動するには --no-template を付けてください"
        fi
        exit 1
    fi

else
    log_info "既存の sandbox を再利用します: $SANDBOX_NAME"
    republish_ports
    load_static_mcp
fi

# 初期化は作成時だけでなくアタッチごとに実行する。bind mount による生成物の分離と
# 公開ポートは sandbox の停止で失われるため、毎回張り直す必要がある（全処理は冪等）。
run_post_create

# 既存 sandbox には agent 名を渡さない（sandbox の spec から解決される）
# 既存 sandbox を位置引数で渡す `sbx run <name>` は deprecated（sbx 0.47 で警告が出る）
run_cmd=(sbx run --name "$SANDBOX_NAME")
[[ -n "$BRANCH" ]] && run_cmd+=(--branch="$BRANCH")
[[ "$REMOVE_ON_EXIT" == true ]] && run_cmd+=(--rm)
[[ ${#AGENT_ARGS[@]} -gt 0 ]] && run_cmd+=(-- "${AGENT_ARGS[@]}")

exec "${run_cmd[@]}"
