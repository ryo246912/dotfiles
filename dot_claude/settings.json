{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "cleanupPeriodDays": 36500,
  "permissions": {
    "allow": [
      "Bash(mise list:*)",
      "Bash(ccmanager --help)",
      "Bash(xcode-select:*)",
      "Bash(claude mcp:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(shfmt:*)",
      "WebFetch(domain:docs.anthropic.com)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Read(.env.*)",
      "Read(**/.envrc)",
      "Read(.envrc)",
      "Read(**/*.secret)",
      "Read(*.secret)",
      "Read(**/fnox.local.toml)",
      "Read(fnox.local.toml)",
      "Read(id_rsa)",
      "Read(id_ed25519)",
      "Read(**/*token*)",
      "Read(**/*key*)",
      "Write(**/.env)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(**/.envrc)",
      "Write(.envrc)",
      "Write(**/*.secret)",
      "Write(*.secret)",
      "Write(**/fnox.local.toml)",
      "Write(fnox.local.toml)",
      "Write(**/secrets/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccusage statusline --visual-burn-rate emoji"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "expo-deployment@expo-plugins": true
  },
  "bash": {
    "blockUnlistedCommands": true
  },
  "git": {
    "includeCoAuthor": false
  }
}
