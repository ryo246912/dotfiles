[color]
  ui = auto
[commit]
  gpgsign = true
[credential]
{% if os() == "macos" %}
  # macOS Keychain。GitHub 自体は下の pushInsteadOf で SSH に寄せているため、これが要るのは
  # GitHub の HTTPS clone や GitHub 以外の HTTPS git host（社内 GitLab 等）向け。
  helper = osxkeychain
{% else %}
  # WSL2 には osxkeychain 相当の OS keychain 連携が無いため、git-credential-manager (GCM) +
  # pass(gpg) の credential store を使い、既存の GPG 鍵（下の user.signingkey）で暗号化して
  # 永続化する。セットアップ手順は docs/credentials.md 参照。
  helper = manager
  credentialStore = gpg
{% endif %}
[core]
  editor = nvim
  excludesfile = ~/.config/git/gitignore
[gpg "ssh"]
  # SSH 署名（sandbox 内の commit は ssh-agent forwarding で SSH 署名される）の検証用。
  # 中身は sbx-agent が「email namespaces="git" 公開鍵」を追記して管理する
  # （docs/docker-sandboxes.md の「ホストの git 設定とコミット署名」参照）。
  allowedSignersFile = ~/.config/git/allowed_signers
[grep]
  lineNumber = true
[merge]
  conflictStyle = diff3
[merge "mergiraf"]
  # 構文を理解する merge driver。適用するファイルは ~/.config/git/attributes（config/git/attributes）で指定。
  # 解決結果は `mergiraf review <file>_<id>`（merge 時に表示される）で line-based merge との差分を確認できる。
  # mergiraf が実行できない（未インストール、mise shim で version 未解決など）まま直接呼ぶと、git はファイルを
  # ours のまま conflict marker なしで conflict 扱いにし theirs の変更が失われるため、その場合は git merge-file に切り替える。
  # 一時的に無効にするときは `mergiraf=0 git rebase ...` のように環境変数を付ける。
  # 値全体を "..." で囲むのは、囲まないと ; 以降が gitconfig のコメント扱いになるため。
  name = mergiraf
  driver = "sh -c 'if mergiraf --version >/dev/null 2>&1; then exec mergiraf merge --git \"$1\" \"$2\" \"$3\" -s \"$4\" -x \"$5\" -y \"$6\" -p \"$7\" -l \"$8\"; fi; exec git merge-file -L \"$5\" -L \"$4\" -L \"$6\" --marker-size \"$8\" \"$2\" \"$1\" \"$3\"' mergiraf %O %A %B %S %X %Y %P %L"
[pager]
  diff = delta
  log = delta
  reflog = delta
  show = delta
[pull]
  ff = only
[push]
  default = current
[url "git@github.com:"]
  pushInsteadOf = git://github.com/
  pushInsteadOf = https://github.com/
[delta]
{% if os() == "macos" %}
  plus-style = "syntax #012800"
  minus-style = "syntax #340001"
{% endif %}
  syntax-theme = base16
  navigate = true
  line-numbers = true
  side-by-side = true
[interactive]
  diffFilter = delta --color-only
[rerere]
  enabled = true
[init]
  defaultBranch = main
[advice]
  skippedCherryPicks = false
[user]
  email = 73044070+ryo246912@users.noreply.github.com
  name = ryo246912
  signingkey = 08BF9A27112516E5
[include]
  path = ~/.config/git/work3/config
{% if os() == "macos" %}
[include]
  path = ~/.config/git/private
[includeIf "gitdir:~/work/"]
  path = ~/.config/git/config.work.secret
[includeIf "gitdir:~/Programming/work3/"]
  path = ~/.config/git/work3.private
{% else %}
[include]
  path = ~/.config/git/config.work.secret
{% endif %}

[secrets]
	providers = git secrets --aws-provider
	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
	patterns = \"?aws_secret_access_key\"?[[:space:]]*[:=][[:space:]]*\"?[A-Za-z0-9/+=]{40}\"?
	patterns = \"?aws_session_token\"?[[:space:]]*[:=][[:space:]]*\"?[A-Za-z0-9/+=]{16,}\"?
