{#- Vicinae の snippets（~/.local/share/vicinae/snippets/snippets.json）。
    公開してよいものだけをここに書く。メールアドレスなどの値は git 管理外の
    templates/vicinae/vicinae.secret.yaml（mise.mac.toml の [vars] で読み込む。雛形は *.sample）に置き、
    {{ vars.<key> | json_encode }} で埋める。PC ごとに要る・要らないが分かれるものは枠を作って
    {% if vars.<key> is defined %} で囲み、値を書いた PC でだけ出す。
    GUI での追加・編集は次の apply で消えるため、変更はこのファイルに書く。
    apply 後は Vicinae を再起動する（起動時にしか読まないため）。 -#}
[
  {
    "id": "snp-8f86f68fcc5a",
    "name": "email(private)",
    "data": { "text": {{ vars.vicinae_email_private | default(value="") | json_encode }} },
    "createdAt": 1789423144,
    "expansion": { "keyword": ",adp", "apps": [], "word": true }
  },
  {
    "id": "snp-e79dc2e6308c",
    "name": "email(work)",
    "data": { "text": {{ vars.vicinae_email_work | default(value="") | json_encode }} },
    "createdAt": 1789449986,
    "expansion": { "keyword": ",adw", "apps": [], "word": true }
  },
  {
    "id": "snp-3891eaa97d69",
    "name": "email(gmail)",
    "data": { "text": {{ vars.vicinae_email_gmail | default(value="") | json_encode }} },
    "createdAt": 1789450001,
    "expansion": { "keyword": ",ado", "apps": [], "word": true }
  },
  {
    "id": "snp-51edcf139b6c",
    "name": "today",
    "data": { "text": "{date format=\"yyyy/MM/dd\"}" },
    "createdAt": 1789450052,
    "expansion": { "keyword": ",d", "apps": [], "word": true }
  },
  {
    "id": "snp-4f61b9106d0f",
    "name": "(?<!($1))$2[否定後読み(Negative lookbehind): (?<!Y)X は Xの前にYがない場合にのみマッチする]",
    "data": { "text": "(?<!({cursor}))" },
    "createdAt": 1789450140
  },
  {
    "id": "snp-41017b91db9b",
    "name": "(?<=($1))$2[肯定後読み(Positive lookbehind): (?<=Y)X はXの前にYがある場合にのみマッチする]",
    "data": { "text": "(?<=({cursor}))" },
    "createdAt": 1789450189
  },
  {
    "id": "snp-50e0d627101f",
    "name": "$1(?!$2)[否定先読みX(?!Y)で、XのあとにYが続かない場合にだけマッチする]",
    "data": { "text": "{cursor}(?!$2)" },
    "createdAt": 1789450212
  },
  {
    "id": "snp-57b0154b205e",
    "name": "$1(?=$2)[肯定先読みX(?=Y)で、XのあとにYが続く場合にだけマッチする]",
    "data": { "text": "{cursor}(?=$2)" },
    "createdAt": 1789450241
  },
  {
    "id": "snp-cec772f6b87a",
    "name": "url text fragment",
    "data": { "text": "#:~:text=" },
    "createdAt": 1789450284
  },
  {
    "id": "snp-e4606ef66a8c",
    "name": "markdown link",
    "data": { "text": "[表示名][定義名リンク]\n[定義名リンク]:url" },
    "createdAt": 1789450310
  }
  {#- 名前も含めて公開したくないものは、名前ごと vicinae.secret.yaml に置いて値を書いた PC でだけ出す -#}
  {%- if vars.vicinae_email_other is defined %},
  {
    "id": "snp-048b28011a37",
    "name": {{ vars.vicinae_name_email_other | default(value="email(other)") | json_encode }},
    "data": { "text": {{ vars.vicinae_email_other | json_encode }} },
    "createdAt": 1789449968,
    "expansion": { "keyword": ",ads", "apps": [], "word": true }
  }
  {%- endif %}
]
