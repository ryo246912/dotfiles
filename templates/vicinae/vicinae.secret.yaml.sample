# templates/vicinae/*.json.tera から {{ vars.<key> }} で参照する値（mise.mac.toml の [vars] で読み込む）。
# このファイルを vicinae.secret.yaml にコピーして埋める（.gitignore 済み）。
# [vars] はリポジトリ全体で共有されるため、キーには vicinae_ を付ける。値は文字列・数値のみ（リスト不可）。
# vicinae_url_* と vicinae_email_other は書いた PC でだけ出る（不要な行は消すかコメントアウトする）。

# snippets（email(private) / email(work) / email(gmail)）
vicinae_email_private: private@example.com
vicinae_email_work: work@example.com
vicinae_email_gmail: someone@gmail.com
# 名前も公開したくないアドレス（,ads。名前を省略すると email(other)）
vicinae_name_email_other: email(other)
vicinae_email_other: other@example.com

# shortcuts
vicinae_url_amazon_wishlist: https://www.amazon.co.jp/hz/wishlist/ls/XXXXXXXXXXXXX
vicinae_url_tabelog: https://tabelog.com/rvwr/000000000/hozon_restaurants/list/
# 仕事用（リポジトリ名も公開しないよう名前ごとここに置く）
vicinae_name_work_repo: work-repo
vicinae_url_work_repo: https://github.com/<org>/<repo>
