  {
    "id": "sct-e40190d09c06",
    "name": "Twitter / X",
    "icon": "icon://favicon/x.com?fallback=icon://omnicast/image?fill%3Dprimary-text",
    "url": "https://x.com/home",
    "app": "default",
    "openCount": 0,
    "createdAt": 1789454023,
    "updatedAt": 1789454023
  },
  {
    "id": "sct-1b76d607552f",
    "name": "Yahoo",
    "icon": "icon://favicon/transit.yahoo.co.jp?fallback=icon://omnicast/image?fill%3Dprimary-text",
    "url": "https://transit.yahoo.co.jp/?from=%E6%AD%A6%E8%94%B5%E5%B0%8F%E6%9D%89&to=",
    "app": "default",
