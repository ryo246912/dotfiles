{#- Vicinae の shortcuts（~/.local/share/vicinae/shortcuts/shortcuts.json）。
    仕事の URL や個人を特定できる ID を含むものは枠だけを書き、値は git 管理外の
    templates/vicinae/vicinae.secret.yaml（mise.mac.toml の [vars] で読み込む。雛形は *.sample）に置く。
    GUI での追加・編集と利用回数（openCount）は次の apply で消えるため、変更はこのファイルに書く。
    apply 後は Vicinae を再起動する（起動時にしか読まず、起動中はメモリ上の一覧で書き戻すため）。 -#}
[
  {
    "id": "sct-083645c29b43",
    "name": "agentview",
    "icon": "icon://favicon/127.0.0.1?fallback=icon://omnicast/image?fill%3Dprimary-text",
    "url": "http://127.0.0.1:8080/sessions",
    "app": "default",
    "openCount": 0,
    "createdAt": 1789452400,
    "updatedAt": 1789452400
  },
  {
    "id": "sct-e1acdecb3508",
    "name": "Google",
    "icon": "icon://omnicast/link?fill=primary-text",
    "url": "https://www.google.com/search?q={selection}",
    "app": "default",
    "openCount": 0,
    "createdAt": 1789452431,
    "updatedAt": 1789452431
  },
  {
    "id": "sct-53083efabbc3",
    "name": "dotfiles",
    "icon": "icon://favicon/github.com?fallback=icon://omnicast/image?fill%3Dprimary-text",
    "url": "https://github.com/ryo246912/dotfiles",
    "app": "default",
    "openCount": 0,
    "createdAt": 1789453959,
    "updatedAt": 1789453959
  },
  {
    "id": "sct-6c3bb1a6fd31",
    "name": "Google Map",
