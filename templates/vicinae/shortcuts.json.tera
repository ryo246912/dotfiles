  },
  {
    "id": "sct-3ac03ebb9625",
    "name": "Google Calendar",
    "icon": "icon://favicon/calendar.google.com?fallback=icon://omnicast/image?fill%3Dprimary-text",
    "url": "https://calendar.google.com/calendar",
    "app": "default",
    "openCount": 0,
    "createdAt": 1789453995,
    "updatedAt": 1789453995
  },
  {
    "id": "sct-d6136306ddde",
    "name": "Grok",
    "icon": "icon://favicon/grok.com?fallback=icon://omnicast/image?fill%3Dprimary-text",
    "url": "https://grok.com/automations",
