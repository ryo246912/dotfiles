# ~/.config/git/config.secret のサンプル。
# 実ファイルは .chezmoiignore で除外しているため chezmoi 管理外・コミット対象外。
# 初回セットアップ時にコピーして値を実際のものに置き換える:
#   cp dot_config/git/config.secret.sample ~/.config/git/config.secret
#
# config.tmpl の [include] から常時読み込まれる（noreply email 等、公開したくない上書き設定用）。

[user]
  email = xxxxx+ryo246912@users.noreply.github.com

[coderabbit]
  machineId = cli/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
