# ~/.config/git/config.work.secret のサンプル。
# 実ファイルは .chezmoiignore で除外しているため chezmoi 管理外・コミット対象外。
# 初回セットアップ時にコピーして値を実際のものに置き換える:
#   cp dot_config/git/config.work.secret.sample ~/.config/git/config.work.secret
#
# config.tmpl から以下のタイミングで読み込まれる:
#   - macOS: [includeIf "gitdir:~/work/"] / [includeIf "gitdir:~/projects/"]
#     （~/work/, ~/projects/ 配下でのみ、仕事用の上書き設定として）
#   - WSL2/Linux: [include]（常時。WSL は仕事用途前提のため）

[user]
  email = xxxxx@work-domain.example.com
  signingkey = XXXXXXXXXXXXXXXX
