# PATH の組み立ては関数にまとめ、$ZDOTDIR/.zprofile からも呼べるようにする。
# zsh は ~/.zshenv → /etc/zprofile → $ZDOTDIR/.zprofile の順に読むが、macOS の
# /etc/zprofile は `/usr/libexec/path_helper -s` で PATH を /etc/paths・/etc/paths.d から
# 再構築し、既存エントリを末尾へ回す。そのためログインシェルでは、ここで先頭に置いた
# /opt/homebrew/bin・mise shims・gnubin が /usr/bin 等の後ろへ落ちてしまう
# （brew 版 git より /usr/bin/git が優先される、GNU 版 sed/grep/find が BSD 版に負ける等）。
# path_helper より後に走る .zprofile で同じ関数を呼び直して打ち消す。
# 非ログインシェルは .zprofile を読まないが path_helper も走らないため、ここでの適用で足りる。
#
# 関数の責務は PATH の順序だけに限定する。`brew shellenv` や `mise activate` のように
# PATH 以外（HOMEBREW_PREFIX・MANPATH・INFOPATH・MISE_SHELL 等）も触るものは関数の外に置き、
# シェルごとに1回だけ流す。INFOPATH のように prepend される変数を再適用で二重に積まないため。
__zsh_setup_path() {
  # パスの重複を除く（関数内でローカル化しないよう -g を付ける）
  typeset -gU path PATH

  # mise shims は brew の bin より前に置く（.chezmoi.toml.tmpl の post-apply hook と同じ理由:
  # 後ろだと実 Homebrew 版の gh 等が mise の aqua shim を shadow する）。
  # HOMEBREW_PREFIX は下の `brew shellenv` が export する。brew 未導入なら
  # 既定値のディレクトリが存在せず (N) で落ちる。
  local mise_shims="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims"
  local brew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"

  if [ "$(uname)" = "Darwin" ]; then
    export ANDROID_HOME=$HOME/Library/Android/sdk
    path=(
      $mise_shims(N)
      $brew_prefix/{bin,sbin}(N)
      $HOME/{,.local/}{,s}bin(N)
      /{opt,usr}/local/{,s}bin(N)
      $brew_prefix/opt/coreutils/libexec/gnubin(N)
      $brew_prefix/opt/findutils/libexec/gnubin(N)
      $brew_prefix/opt/grep/libexec/gnubin(N)
      $brew_prefix/opt/gnu-sed/libexec/gnubin(N)
      $HOME/.cargo/bin(N)
      $HOME/go/bin(N)
      $ANDROID_HOME/emulator(N)
      $ANDROID_HOME/platform-tools(N)
      $path
    )
  else
    path=(
      $mise_shims(N)
      $HOME/{,.local/}{,s}bin(N)
      /{opt,usr}/local/{,s}bin(N)
      $HOME/.cargo/bin(N)
      $HOME/go/bin(N)
      $path
    )
  fi
}

# PATH 以外も設定するため関数の外（= シェルごとに1回だけ）で流す。
# ここでの PATH への prepend は直後の __zsh_setup_path が組み直すので順序には影響しない。
if [ "$(uname)" = "Darwin" ]; then
{{ if (lookPath "brew") -}}
{{ output "brew" "shellenv" | trim }}
{{- end }}
fi

__zsh_setup_path

# HOST_ENV をホスト名で解決する
if [ -z "${HOST_ENV:-}" ]; then
    _host_id="${MISE_HOST_ID:-$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null)}"
    _host_env="$(awk -F'[[:space:]]*=[[:space:]]*' -v h="$_host_id" \
        '!/^[[:space:]]*(#|$)/ && $1 == h {print $2; exit}' \
        "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/host-env.map" 2>/dev/null)"
    [ -n "$_host_env" ] && export HOST_ENV="$_host_env"
    # agentsview (docs/agentsview.md) の machine 名。HOST_ENV（例: mac,work2）の ',' を '-' に
    # 置き換えた mac-work2 のような形にする。
    [ -n "$_host_env" ] && export AGENTSVIEW_PG_MACHINE="${AGENTSVIEW_PG_MACHINE:-${_host_env//,/-}}"
    unset _host_id _host_env
fi

# HOST_ENV から MISE_ENV を導出
if [ -z "${MISE_ENV:-}" ] && [ -n "${HOST_ENV:-}" ]; then
    export MISE_ENV="$HOST_ENV"
fi

# HOST_ENV に work ロール（work1/work2）が含まれるホストだけ FNOX_PROFILE=work を有効化する
# （dot_config/fnox/config.toml が import する config.work.toml の [profiles.work.*] 用）
if [ -z "${FNOX_PROFILE:-}" ]; then
    case "${HOST_ENV:-}" in
        *work*) export FNOX_PROFILE="work" ;;
    esac
fi

if command -v mise >/dev/null 2>&1; then
{{ if (lookPath "mise") -}}
{{ output "mise" "activate" "zsh" "--shims" | trim }}
{{- end }}
fi

# Editor
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
else
  export EDITOR=vim
fi
export VISUAL="$EDITOR"
export GIT_EDITOR="$EDITOR"
