# cSpell:disable

# launch tmux when start zsh
should_auto_attach_tmux=0

case "${TERM:-}" in
  alacritty|rio|ghostty|xterm-ghostty)
    should_auto_attach_tmux=1
    ;;
  *)
    case "${TERM_PROGRAM:-}" in
      WezTerm|ghostty|Ghostty)
        should_auto_attach_tmux=1
        ;;
    esac
    ;;
esac

if [ "$should_auto_attach_tmux" -eq 1 ] && command -v tmux &> /dev/null && [ -z "$TMUX" ]; then
  tmux attach || tmux
fi

for file in $XDG_CONFIG_HOME/zsh/*.zsh; do
  [[ "$file" == *lazy.zsh ]] && continue
  # work.zsh は HOST_ENV に work が含まれる場合のみ読み込む
  if [[ "$file" == *work.zsh ]]; then
    [[ "${HOST_ENV:-}" == *work* ]] || continue
  fi
  source "$file"
done

### sheldon (zsh プラグインマネージャ) ###
# プラグインは dot_config/sheldon/plugins.toml で管理し、romkatv/zsh-defer により
# zinit の turbo mode 相当の遅延ロードを行う。sheldon 本体は mise で導入する。

# macOS 限定プラグイン（zsh-auto-notify 等）を有効化する profile
if [ "$(uname)" = "Darwin" ]; then
  export SHELDON_PROFILE="macos"
fi

if command -v sheldon >/dev/null 2>&1; then
  # `sheldon source` の出力をキャッシュして起動を高速化する
  # （plugins.toml がキャッシュより新しい場合のみ再生成する）
  _sheldon_conf="${XDG_CONFIG_HOME}/sheldon/plugins.toml"
  # profile ごとにロードするプラグインが異なるためキャッシュも profile 別に分ける
  # （例: macOS は plugins.macos.zsh、profile 無しは plugins.zsh）
  _sheldon_cache="${XDG_CACHE_HOME}/sheldon/plugins${SHELDON_PROFILE:+.${SHELDON_PROFILE}}.zsh"
  if [[ ! -r "$_sheldon_cache" || "$_sheldon_conf" -nt "$_sheldon_cache" ]]; then
    command mkdir -p "${_sheldon_cache:h}"
    # 生成に失敗した場合は壊れたキャッシュを source しないよう一時ファイル経由で置き換える
    if sheldon source > "${_sheldon_cache}.tmp" 2>/dev/null; then
      command mv "${_sheldon_cache}.tmp" "$_sheldon_cache"
    else
      command rm -f "${_sheldon_cache}.tmp"
    fi
  fi
  [[ -r "$_sheldon_cache" ]] && source "$_sheldon_cache"
  unset _sheldon_conf _sheldon_cache
fi

# lazy.zshを遅延読み込み（zinit の null プラグイン + atinit 相当）。
# zsh-defer が読み込めていれば遅延ロード、無ければ同期で読み込む。
if (( $+functions[zsh-defer] )); then
  zsh-defer source "${HOME}/.config/zsh/lazy.zsh"
else
  source "${HOME}/.config/zsh/lazy.zsh"
fi
