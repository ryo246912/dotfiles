#!/bin/bash
set -euo pipefail

listen_port=${PLANNOTATOR_FORWARD_PORT:-19432}
target_port=${PLANNOTATOR_PORT:-19433}
pid_file=${HOME}/.plannotator-relay.pid
log_file=${HOME}/.plannotator-relay.log
relay=${HOME}/.config/devcontainer/scripts/plannotator-relay

relay_ready() {
	(echo >"/dev/tcp/127.0.0.1/${listen_port}") >/dev/null 2>&1
}

if [ -s "$pid_file" ]; then
	pid=$(cat "$pid_file")
	cmdline=""
	if [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
		cmdline=$(tr '\0' ' ' <"/proc/${pid}/cmdline")
	fi
	if [[ $cmdline == *plannotator-relay* ]] && relay_ready; then
		exit 0
	fi
fi

rm -f "$pid_file"
nohup "$relay" "$listen_port" "$target_port" >"$log_file" 2>&1 &
pid=$!
echo "$pid" >"$pid_file"

for _ in 1 2 3 4 5; do
	if kill -0 "$pid" 2>/dev/null && relay_ready; then
		exit 0
	fi
	sleep 1
done

cat "$log_file" >&2
rm -f "$pid_file"
exit 1
