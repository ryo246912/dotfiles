{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "pedantic": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "plugins": [
    "import",
    "node",
    "promise",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "rules": {
    "import/no-default-export": "off"
  }
}
