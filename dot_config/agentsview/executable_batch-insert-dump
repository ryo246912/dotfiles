#!/usr/bin/env python3
r"""pg_dumpのplain dumpから、CockroachDBへ流せるINSERT列だけを取り出す。

`--data-only --column-inserts` のdumpには、INSERT以外にpsqlのmeta-command
（`\restrict`）、`SET`、`SELECT pg_catalog.setval(...)` が混ざる。CockroachDBは
これらを解釈できない、または対象のsequenceを持たないため、statement単位で
INSERTだけを残す。dump中のsession本文はSQL文字列そのものを含みうるので、
行のpatternではなく文字列literalとcommentを追跡して区切る。

出力はBEGIN/COMMITで包んだ固定件数のchunkにする。CockroachDBは1 transactionで
書ける量に上限があり、dump全体を1 transactionにすると失敗しうる。
"""

import os
import re
import sys

CHUNK_ENV = "AGENTSVIEW_IMPORT_CHUNK_ROWS"
TOKEN = re.compile(r"'|\"|--|/\*|;|\$[A-Za-z_][A-Za-z_0-9]*\$|\$\$")


def chunk_size() -> int:
    raw = os.environ.get(CHUNK_ENV, "500")
    try:
        value = int(raw)
    except ValueError:
        raise SystemExit(f"{CHUNK_ENV} must be a positive integer: {raw}") from None
    if value < 1:
        raise SystemExit(f"{CHUNK_ENV} must be a positive integer: {raw}")
    return value


class Splitter:
    """dumpをstatementへ切り分ける。stateは行をまたいで持続する。"""

    def __init__(self) -> None:
        self.buffer: list[str] = []
        # None以外のときは、その閉じtokenまでliteral／comment内にいる。
        self.pending = ""
        self.escape = False
        self.block_depth = 0

    def feed(self, line: str):
        """1行を読み、完成したstatementをyieldする。"""

        pos = 0
        while pos < len(line):
            if self.pending:
                pos = self._consume_pending(line, pos)
                continue
            match = TOKEN.search(line, pos)
            if match is None:
                self.buffer.append(line[pos:])
                return
            self.buffer.append(line[pos : match.start()])
            token = match.group(0)
            pos = match.end()
            if token == ";":
                self.buffer.append(";")
                statement = "".join(self.buffer)
                self.buffer = []
                yield statement
                continue
            self.buffer.append(token)
            if token == "'":
                # 直前がE（識別子の一部ではない）なら、backslash escapeが有効になる。
                prefix = "".join(self.buffer)[:-1]
                self.escape = bool(re.search(r"(?:^|[^A-Za-z_0-9$])[eE]$", prefix))
                self.pending = "'"
            elif token == '"':
                self.escape = False
                self.pending = '"'
            elif token == "--":
                self.pending = "\n"
            elif token == "/*":
                self.block_depth = 1
                self.pending = "*/"
            else:
                self.escape = False
                self.pending = token

    def _consume_pending(self, line: str, pos: int) -> int:
        """literal／comment内を、閉じtokenまで読み進める。"""

        if self.pending == "\n":
            self.buffer.append(line[pos:])
            self.pending = ""
            return len(line)
        if self.pending == "*/":
            return self._consume_block_comment(line, pos)
        closer = self.pending
        index = pos
        while True:
            if self.escape and closer == "'":
                found = self._find_quote_with_escapes(line, index)
            else:
                found = line.find(closer, index)
            if found < 0:
                self.buffer.append(line[pos:])
                return len(line)
            end = found + len(closer)
            if closer in {"'", '"'} and line.startswith(closer * 2, found):
                # '' と "" はliteral内のescapeなので、閉じtokenではない。
                index = found + 2
                continue
            self.buffer.append(line[pos:end])
            self.pending = ""
            self.escape = False
            return end

    def _consume_block_comment(self, line: str, pos: int) -> int:
        """入れ子を数えながらblock commentを読む。"""

        index = pos
        while self.block_depth:
            opening = line.find("/*", index)
            closing = line.find("*/", index)
            if closing < 0 and opening < 0:
                self.buffer.append(line[pos:])
                return len(line)
            if opening >= 0 and (closing < 0 or opening < closing):
                self.block_depth += 1
                index = opening + 2
                continue
            self.block_depth -= 1
            index = closing + 2
        self.buffer.append(line[pos:index])
        self.pending = ""
        return index

    @staticmethod
    def _find_quote_with_escapes(line: str, start: int) -> int:
        """E'...' 内で、backslash escapeを飛ばして次の ' を探す。"""

        index = start
        while index < len(line):
            char = line[index]
            if char == "\\":
                index += 2
                continue
            if char == "'":
                return index
            index += 1
        return -1

    def tail(self) -> str:
        return "".join(self.buffer)


def strip_leading_noise(text: str) -> str:
    """先頭のcommentと空白を落として、statement本体の先頭を返す。"""

    while True:
        text = text.lstrip()
        if text.startswith("--"):
            newline = text.find("\n")
            text = "" if newline < 0 else text[newline + 1 :]
            continue
        if text.startswith("/*"):
            # block commentは入れ子になれるので、深さを数えて閉じ位置を探す。
            # 閉じていない場合は捨てずにそのまま返す。空を返すと、fileが
            # comment途中で切れたdumpを「残りは無い」と誤って扱ってしまう。
            depth = 1
            index = 2
            while depth and index < len(text):
                opening = text.find("/*", index)
                closing = text.find("*/", index)
                if closing < 0:
                    return text
                if 0 <= opening < closing:
                    depth += 1
                    index = opening + 2
                    continue
                depth -= 1
                index = closing + 2
            if depth:
                return text
            text = text[index:]
            continue
        return text


def main() -> int:
    limit = chunk_size()
    splitter = Splitter()
    out = sys.stdout
    kept = 0
    skipped = 0
    in_chunk = 0
    out.write("SET client_encoding = 'UTF8';\n")
    for line in sys.stdin:
        # psqlのmeta-command（`\restrict`）はSQLではないので、statement扱いしない。
        # 直前のstatementを閉じた後のcommentだけが溜まっている状態でも捨てられるよう、
        # bufferはcommentを除いて空かどうかで判定する。
        if (
            not splitter.pending
            and line.startswith("\\")
            and not strip_leading_noise(splitter.tail())
        ):
            splitter.buffer = []
            skipped += 1
            continue
        for statement in splitter.feed(line):
            body = strip_leading_noise(statement)
            if body[:6].upper() != "INSERT":
                if body:
                    skipped += 1
                continue
            if in_chunk == 0:
                out.write("BEGIN;\n")
            out.write(body.strip())
            out.write("\n")
            kept += 1
            in_chunk += 1
            if in_chunk >= limit:
                out.write("COMMIT;\n")
                in_chunk = 0
    if in_chunk:
        out.write("COMMIT;\n")
    # pendingが残るのは、文字列literal・dollar quote・block commentの途中でfileが
    # 終わった場合だけである（行commentは行末で閉じる）。切り詰められたdumpを
    # 取り込み済みのchunkだけで成功扱いにしないよう、ここで必ず止める。
    if splitter.pending:
        print(
            f"dump ends inside a string literal or comment: {splitter.tail()[-80:]}",
            file=sys.stderr,
        )
        return 1
    leftover = strip_leading_noise(splitter.tail()).strip()
    if leftover:
        print(f"unterminated statement at end of dump: {leftover[:80]}", file=sys.stderr)
        return 1
    print(f"INSERT statements: {kept} (skipped {skipped} non-INSERT statements)", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
